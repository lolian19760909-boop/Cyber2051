    if(selection.kind==='place'&&window.TOKYO_TERMINAL_MAP_CONTROL)return window.TOKYO_TERMINAL_MAP_CONTROL.focus(selection.mapId||'tokyo-central',selection.id);
    const record = recordOf(selection);
    if (!record) return false;
    readerRecord = selection; readerOpener = opener;
    const body = $('reader-body'); body.replaceChildren();
    const title = element('h1', '', record.name); title.id = 't2051x-reader-title';
    body.append(title, element('p', 'cover', recordCover(record)));
    if (record.desc) body.append(element('p', 'description', record.desc));
    else if (selection.kind === 'place') body.append(element('p', 'empty-result', '暂无收录该地点的正式档案。可以先在地图中查看位置与已有关联。'));
    if (record.dims) body.append(dimensions(record));
    body.append(element('p', 'record-code', 'ARCHIVE / ' + record.id.toUpperCase()));
    $('reader-kind').textContent = selection.kind === 'region' ? 'SECTOR RECORD / 地区' : 'PLACE RECORD / 地点';
    $('reader-map').hidden = selection.kind !== 'place';
    openDialog($('reader')); body.scrollTop = readingPositions.get(selectionKey(selection)) || 0;
    return true;
  }
  $('close-reader').addEventListener('click', () => closeDialog($('reader')));
  $('reader').addEventListener('close', () => {
    if (readerRecord) readingPositions.set(selectionKey(readerRecord), $('reader-body').scrollTop);
    if (readerOpener?.isConnected) readerOpener.focus({ preventScroll: true });
  });
  $('reader-map').addEventListener('click', () => {
    const selection = readerRecord;
    if (!selection || selection.kind !== 'place') return;
    const mapId = selection.mapId || 'tokyo-central', control = window.TOKYO_TERMINAL_MAP_CONTROL;
    $('reader').close();
    if(!control?.focus(mapId,selection.id))announce('暂时无法定位这个地点，请重新打开地图。');
  });
  function openViewer(label, list, pos, opener) {
    if (!list?.length) return;
    viewerLabel = label; viewerList = list; viewerPos = pos; viewerOpener = opener;
    viewerScrollHost = opener?.closest?.('.module-content') || null;
    viewerScrollTop = viewerScrollHost ? viewerScrollHost.scrollTop : 0;
    updateViewer();
    openDialog($('gallery-viewer'));
    announce('已打开图片查看器');
  }
  function updateViewer() {
    const pic = $('viewer-pic');
    const feedback = $('viewer-feedback');
    feedback.hidden = true;
    pic.classList.remove('loaded');
    pic.alt = viewerLabel + ' ' + (viewerPos + 1);
    pic.onload = () => { pic.classList.add('loaded'); feedback.hidden = true; };
    pic.onerror = () => { pic.classList.remove('loaded'); feedback.hidden = false; };
    const resources = window.CxxResources || window.parent.CxxResources;
    pic.src = resources?.source(viewerList[viewerPos]) || viewerList[viewerPos];
    if (pic.complete && pic.naturalWidth > 0) pic.classList.add('loaded');
    $('viewer-label').textContent = viewerLabel;
    $('viewer-name').textContent = viewerLabel.split(' · ')[0];
    $('viewer-position').textContent = String(viewerPos + 1).padStart(2, '0') + ' / ' + String(viewerList.length).padStart(2, '0');
  }
  $('close-viewer').addEventListener('click',()=>closeDialog($('gallery-viewer')));
  $('viewer-retry').addEventListener('click', () => {
    const resources = window.CxxResources || window.parent.CxxResources;
    if (resources?.source(viewerList[viewerPos]) !== viewerList[viewerPos]) resources?.retry();
    updateViewer();
  });
  $('viewer-prev').addEventListener('click', () => { viewerPos = (viewerPos - 1 + viewerList.length) % viewerList.length; updateViewer(); });
  $('viewer-next').addEventListener('click', () => { viewerPos = (viewerPos + 1) % viewerList.length; updateViewer(); });
  $('gallery-viewer').addEventListener('keydown', e => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); $('viewer-prev').click(); }
    if (e.key === 'ArrowRight') { e.preventDefault(); $('viewer-next').click(); }
  });
  $('gallery-viewer').addEventListener('close', () => {
    if (viewerScrollHost?.isConnected) viewerScrollHost.scrollTop = viewerScrollTop;
    if (viewerOpener?.isConnected) viewerOpener.focus({ preventScroll: true });
  });
  function renderArchive() {
    const list = $('archive-grid'), query = $('archive-search').value.trim().toLocaleLowerCase();
    const previous = selectionKey(archiveItems[archiveIndex]?.selection);
    list.replaceChildren();
    const names = { city: '城市档案', setting: '世界设定', library: '文库' }, cityCount = data.regions.length + locationRecords.length;
    list.setAttribute('aria-label', names[archiveKind] + '列表');
    rootEl.querySelectorAll('[data-archive]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.archive === archiveKind)));
    rootEl.querySelectorAll('[data-archive-count]').forEach(b => { b.textContent = b.dataset.archiveCount === 'city' ? String(cityCount) : '0'; });
    $('archive-kind-title').textContent = names[archiveKind];
    $('archive-description').textContent = archiveKind === 'city' ? '地区概况与地点索引。尚无正文的地点会标明，位置可在地图中查看。' : '公开的记录将在此归档。';
    $('archive-count').textContent = archiveKind === 'city' ? String(cityCount) : '0';
    $('archive-search-box').hidden = archiveKind !== 'city';
    archiveItems = [];
    if (archiveKind !== 'city') {
      const empty = element('div', 'sec-empty');
      empty.append(element('p', '', '暂无可读取的' + names[archiveKind] + '。'), button('返回城市档案', 'sec-link', () => { archiveKind = 'city'; renderArchive(); }));
      list.append(empty); $('archive-selection').hidden = true; $('page-archive').dataset.view = 'list';
      return;
    }
    archiveItems = [...data.regions.map(r => ({ selection: { kind: 'region', id: r.id }, record: r })),
      ...locationRecords.map(n => ({ selection: { kind: 'place', mapId: n.mapId, id: n.id }, record: n }))].filter(item => (item.record.name + ' ' + recordCover(item.record)).toLocaleLowerCase().includes(query));
    // Regions first, then places, each under its own group title.
    const groups = [['地区', 'region'], ['地点', 'place']];
    for (const [label, kind] of groups) {
      const members = archiveItems.map((item, index) => [item, index]).filter(([item]) => item.selection.kind === kind);
      if (!members.length) continue;
      list.append(element('p', 'sec-group', label + ' · ' + members.length));
      for (const [item, index] of members) {
        const row = button('', 'sec-row archive-row', () => { void motion.swap($('archive-selection'),()=>{positionArchive(index);$('page-archive').dataset.view='detail';}); sectionMotion('select', $('page-archive')); if (mobileQuery.matches) $('archive-back').focus({ preventScroll: true }); });
        row.dataset.index = index;
        row.setAttribute('aria-label', item.record.name + '，' + (kind === 'region' ? '地区档案' : item.record.desc ? '地点档案' : '地点索引，暂无正式档案'));
        const icon = element('span', 'sec-icon archive-icon'); icon.setAttribute('aria-hidden', 'true');
        row.append(icon, element('strong', '', item.record.name), element('span', 'archive-code', String(index + 1).padStart(3, '0')),
          element('small', '', (kind === 'region' ? (item.record.en || '地区') : item.record.cat) + ' · ' + recordCover(item.record)));
        list.append(row);
      }
    }
    if (!archiveItems.length) list.append(element('p', 'sec-empty', '没有匹配资料，请试试其他名称。'));
    $('archive-selection').hidden = !archiveItems.length;
    if (!archiveItems.length) $('page-archive').dataset.view = 'list';
    positionArchive(Math.max(0, archiveItems.findIndex(item => selectionKey(item.selection) === previous)));
  }
  let archiveItems = [], archiveIndex = 0, archiveFigureTurn = 0;
  const archiveMap = 'url("data:image/svg+xml,' + encodeURIComponent(data.svg) + '")';
  // The record picture follows the story's background index by place name; the city map stands in otherwise.
  function showArchiveFigure(record) {
    const img = $('archive-figure'), turn = ++archiveFigureTurn, host = window.parent;
    let url = ''; try { url = host.__cxx_gal_g1__?.background?.({ location: record.name, time: '' })?.url || ''; } catch {}
    img.parentElement.style.backgroundImage = archiveMap; img.hidden = true; img.removeAttribute('src');
    if (!url) return;
    const resources = host.CxxResources;
    Promise.resolve(resources ? resources.acquire(url) : { url, release() {} }).then(async lease => {
      try { if (turn !== archiveFigureTurn) return; const full = new Image(); full.src = lease.url; await full.decode(); if (turn === archiveFigureTurn) { img.src = full.src; img.hidden = false; } }
      finally { lease.release?.(); }
    }).catch(() => {});
  }
  function positionArchive(index, focus = false) {
    if (!archiveItems.length) return;
    archiveIndex = (index + archiveItems.length) % archiveItems.length;
    const current = archiveItems[archiveIndex], record = current.record, region = current.selection.kind === 'region';
    $('archive-grid').querySelectorAll('.archive-row').forEach(row => {
      const on = Number(row.dataset.index) === archiveIndex;
      row.setAttribute('aria-pressed', String(on)); row.tabIndex = on ? 0 : -1;
    });
    $('archive-position').textContent = String(archiveIndex + 1).padStart(2, '0') + ' / ' + String(archiveItems.length).padStart(2, '0');
    $('archive-prev').disabled = $('archive-next').disabled = archiveItems.length === 1;
    $('archive-selected-kind').textContent = region ? 'SECTOR RECORD / 地区' : 'PLACE RECORD / ' + record.cat;
    $('archive-selected-title').textContent = record.name;
    $('archive-selected-description').textContent = recordCover(record) + (!region && !record.desc ? ' · 暂无正式档案' : '');
    const facts = $('archive-facts'); facts.replaceChildren();
    if (record.dims) facts.append(dimensions(record));
