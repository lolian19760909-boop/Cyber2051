(() => {
  'use strict';
  const Popover=typeof module==='object'&&module.exports?require('../共享/popover.js'):globalThis.CxxPopover;
  let activeModulePage=null;
  const $ = id => id==='page-other'&&activeModulePage?activeModulePage:document.getElementById('t2051x-' + id);
  const rootEl = document.getElementById('t2051x-root');
  if (!rootEl) return;
  const motion = globalThis.CxxMotion.mount(rootEl);
  const pageNode = id => moduleViews.get(id)?.root || $('page-' + id);
  const legacyTaskLocations=[{"questId":"q01","mapId":"tokyo-central","placeId":"a-yang-clinic","evidenceField":"goal","source":{"title":"巴的采购单","district":"红花街","brief":"巴的诊所你总该听过——收费实在，手艺好，能扛事。她订了批皮下护甲，卖家临时放了鸽子，货现在蹲在清道夫的抛货点里落灰。你去把它端回来，巴付账，我抽一成。别问货是哪来的，你也没看见，对吧。","goal":"到抛货点清点并取回整批皮下护甲（六套），送到巴的诊所后账。"}},{"questId":"q02","mapId":"tokyo-central","placeId":"a-yang-clinic","evidenceField":"goal","source":{"title":"被盯上的壳","district":"红花街","brief":"有个机偶姑娘在红花街西口被人盯上了——清道夫那帮摘器官的把她当成行走的备件库。她弟弟在我的柜台上押了最后一枚旧币换消息，我收下了，也打算把事情办了。把人带去巴的诊所，别让她变成夜市摊上的零件。","goal":"找到她（西口夜市一带），把她完整地送到巴的诊所。"}},{"questId":"q03","mapId":"tokyo-central","placeId":"ring-live","evidenceField":"brief","source":{"title":"把吉他送过铁丝网","district":"RiNG 社区","brief":"河沿那边有支小乐队租了排练房，一把旧世代的贝斯还押在我们仓库。明晚他们要用——但这把琴比在场一半人的年纪都大，磕一下就是事故。你腿脚利索，帮我把它从 RING-Live! 后门送到荒川河沿。都是街坊的事，别让我失望。","goal":"明晚八点前，把贝斯完好送到荒川河沿的排练房，拿回签收条。"}},{"questId":"q04","mapId":"tokyo-central","placeId":"ring-community","evidenceField":"brief","source":{"title":"谁在偷我们的电","district":"RiNG 社区","brief":"RiNG 社区这礼拜跳了三次闸，全楼道的义眼都得重启。电是我管的，账是我平的，跳下去我先倒霉。社区管道图上多出一条不存在的支线——顺着它查，看看是哪路神仙在偷电。查清楚了就行，怎么处理等我发话。","goal":"查明偷电支线的源头与用途，回报玲姐。"}}];
  function bindLegacyLocation(q){if(q.placeId)return q;const b=legacyTaskLocations.find(b=>b.questId===q.id&&Object.keys(b.source).every(k=>q[k]===b.source[k]));return b?{...q,mapId:b.mapId,placeId:b.placeId}:q;}
  window.CxxTerminalBoot?.stage(0,'done');window.CxxTerminalBoot?.log('terminal','load','组件','已载入');window.CxxTerminalBoot?.stage(1,'now');
  const sourceData=window.T2051_DATA;
  const baseData={...sourceData,quests:sourceData.quests.map(bindLegacyLocation)};
  let installedSnapshot,hasInstalledSnapshot=false;
  const contentClient={...window.CxxContent,readHost(){if(!hasInstalledSnapshot){installedSnapshot=window.CxxContent?.readHost();hasInstalledSnapshot=true;}return installedSnapshot;}};
  let data = baseData;
  function refreshContent() {
    const installed = contentClient?.readHost();
    data = installed ? contentClient.view(baseData, installed.registry, readStatData()?.terminal?.quests || {}, {
      subscriptions: installed.subscriptions, pins: contentClient.chatPins(), mediaPreferences: installed.mediaPreferences,
      initialContent: installed.initialContent, initialAvatars: installed.initialAvatars,
    }) : baseData;
    data={...data,quests:(data.quests||[]).map(bindLegacyLocation)};
  }
  if (!data || !Array.isArray(data.nodes) || !Array.isArray(data.regions)) {
    const error = document.createElement('p');
    error.className = 'fatal';
    error.textContent = '终端资料未载入。请收起终端后重新打开；若持续出现请向作者反馈。';
    rootEl.append(error);
    return;
  }
  function pendingButton(label){const b=button(label,'quiet cxx-pending',()=>{});b.disabled=true;b.append(element('small','cxx-pending-badge','待更新'));b.title='将在后续版本开放';return b;}
  const QUESTS_AVAILABLE = true;
  const modules = [
    { id: 'city', name: '城市', en: 'CITY ATLAS' },
    { id: 'operations', name: '委托', en: 'JOURNAL', tabs: ['主线任务', '任务委托', '历史记录'], empty: '暂无可读取的任务', description: '主线、委托与行动记录汇集于此。', customTab: 1 },
    { id: 'network', name: '通讯', en: 'NETWORK', tabs: ['东京都新闻', '网路论坛', '广播电台'], empty: '暂无可读取的网路内容', description: '城市的新闻与街头的声音，在这里交汇。', custom: 'net' },
    { id: 'characters', name: '人物', en: 'CHARACTERS', tabs: ['人物表', '人物', '天赋', '物品栏', '义体'], empty: '暂无可读取的角色档案', description: '人物状态与装备配置，将在同一份档案中呈现。' },
    { id: 'media', name: '影像', en: 'MEMORY INDEX', tabs: ['插画', '事件 CG', '特殊场景 CG', '剧情插图'], empty: '暂无可读取的影像', description: '独立保存事件与场景中的记忆。', customTab: 0 },
    { id: 'archive', name: '资料库', en: 'ARCHIVE' },
    { id: 'settings', name: '设置', en: 'PREFERENCES' }
  ];
  const storageKey = 'tokyo2051-terminal-v1';
  const mainModules=['characters','city','operations','network','archive','settings'].map(id=>modules.find(m=>m.id===id));
  const groupOf=id=>id==='media'?'archive':id;
  const navCount=rootEl.querySelector('.nav-heading i');if(navCount)navCount.textContent=String(mainModules.length).padStart(2,'0');
  const viewKey='cxx-terminal-view:'+ (window.parent.Cxx233Runtime?.key()||'preview');
  let viewState={tabs:{},scroll:{},mapViews:{},mapId:'tokyo-central'},viewTimer=null,terminalVisible=false;
  try{const old=JSON.parse(sessionStorage.getItem(viewKey)||'null');if(old&&typeof old==='object')viewState={...viewState,...old,tabs:old.tabs||{},scroll:old.scroll||{}};}catch{}
  const lastSignatures={},moduleViews=new Map(),appListeners=new Set(),stats={created:0,updates:0,reads:0},history=[];
  const emitApp=event=>{for(const cb of appListeners)cb(event||{});};
  function saveView(){if(!viewState.scroll||!viewState.tabs)return;viewState.workspace||={};viewState.workspace[state.page]=$('workspace').scrollTop;for(const [id,entry]of moduleViews)if(!entry.root.hidden)viewState.scroll[id]=(entry.root.querySelector('.module-content')||entry.root).scrollTop;viewState.player=moduleViews.get('characters')?.player?.readViewState?.()||viewState.player;viewState.archive={kind:archiveKind,index:archiveIndex,query:$('archive-search').value};viewState.tabs={...selectedModuleTabs};try{sessionStorage.setItem(viewKey,JSON.stringify(viewState));}catch{}}
  const scheduleView=()=>{clearTimeout(viewTimer);viewTimer=setTimeout(saveView,100);};

  const defaults = { motion: 'full', font: 16, texture: 35, restore: true };
  const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
  let stored = {};
  try { stored = JSON.parse(localStorage.getItem(storageKey) || '{}') || {}; } catch { /* file:// or blocked storage still works in memory */ }
  const prefs = Object.assign({}, defaults, stored.prefs);
  if (!['full', 'reduced', 'off'].includes(prefs.motion)) prefs.motion = 'full';
  prefs.font = clamp(Number(prefs.font) || 16, 14, 22);
  prefs.texture = clamp(Number(prefs.texture) || 0, 0, 70);
  prefs.restore = prefs.restore === true;
  const regionById = new Map(data.regions.map(r => [r.id, r]));
  const nodeById = new Map(data.nodes.map(n => [n.id, n]));
  const locationKey = (mapId, id) => (mapId || 'tokyo-central') + ':' + id;
  const locationRecords = (data.locationMaps || [{ id: 'tokyo-central', places: data.nodes }]).flatMap(map => map.places.map(place => {
    const original = map.id === 'tokyo-central' ? nodeById.get(place.id) : null;
    return { ...original, id: place.id, name: place.name, mapId: map.id, cat: original?.cat || '地点',
      cover: original?.cover || [map.name, place.district || regionById.get(original?.group)?.name].filter(Boolean).join(' / ') };
  }));
  const locationById = new Map(locationRecords.map(record => [locationKey(record.mapId, record.id), record]));
  const selectionKey = selection => selection ? selection.kind + ':' + locationKey(selection.mapId, selection.id) : '';
  const recordCover = record => record.cover || regionById.get(record.group)?.name || '城市档案';
  const state={page:'city',questId:null};
  let readerRecord=null,readerOpener=null,archiveKind='city';
  let galleryIndex = 0, galleryCat = 'standard', viewerList = [], viewerPos = 0, viewerOpener = null, viewerLabel = '';
  let viewerScrollHost = null, viewerScrollTop = 0;
  let netDynamicVersion = 0;
  const selectedModuleTabs = {...viewState.tabs};
  let netRadioView = null, netRequest = null;
  function stopNetwork() {
    // Page visibility only owns news requests; audio belongs to the shared radio.
    if (netRequest) { netRequest.reason = 'leave'; netRequest.controller.abort(); }
  }
  const newsService=()=>window.parent?.__cxx_experience__;
  const NET_CFG_KEY = storageKey + '-net-v1';
  let netCfgMemory = {};
  function netCfg() {
    if(newsService())return newsService().config();
    try { netCfgMemory = JSON.parse(localStorage.getItem(NET_CFG_KEY) || '{}') || {}; } catch { /* 当前会话仍可配置 */ }
    return netCfgMemory;
  }
  function saveNetCfg(patch) {
    if(newsService())return newsService().configure(patch);
    try {
      const merged = Object.assign(netCfg(), patch);
      netCfgMemory = merged;
      localStorage.setItem(NET_CFG_KEY, JSON.stringify(merged));
      return merged;
    } catch { return netCfg(); }
  }
  let netState;
  function netDyn(){return newsService()?newsService().state({light:true}).dynamic||{}:netState?.readDynamic()||{};}
  function saveNetDyn(dyn,ticket){return netState.commit(ticket,dyn);}

  // ===== 账本存取：优先问状态统一入口 Cxx236State（数据库表），未连接时回退本机试玩存档 =====
  const LEDGER_DEMO_KEY = storageKey + '-ledger-demo';
  function readStatData(){stats.reads++;const live=window.parent?.Cxx236State;if(live&&typeof live.stat==='function'){try{const value=live.stat();if(value&&value.terminal)return value;}catch(error){}}return window.parent.Cxx233Runtime?.statusSnapshot?.(getLastMessageId())?.stat_data||hostBridge.readState().statData;}
  const ledgerMvu = () => typeof getVariables === 'function' && typeof getLastMessageId === 'function';
  // 酒馆助手 4.11.2 实装源码：getVariables / updateVariablesWith 默认是 chat，必须显式指定 message。
  async function updateTerminal(update){return hostBridge.updateLedger(update);}
  function demoLedger() {
    try { return JSON.parse(localStorage.getItem(LEDGER_DEMO_KEY) || '{}') || {}; } catch { return {}; }
  }
  function questRecord(id) {
    if (ledgerMvu()) {
      const rec = readStatData()?.terminal?.quests?.[id];
      return { state: rec?.state || '已发布', rank: rec?.rank || '', acceptedFloor: Number(rec?.acceptedFloor) || 0, definitionRef: rec?.definitionRef };
    }
    const rec = demoLedger().quests?.[id] || {};
    return { state: rec.state || '已发布', rank: rec.rank || '', acceptedFloor: Number(rec.acceptedFloor) || 0, definitionRef: rec.definitionRef };
  }
  function walletYen() {
    if (ledgerMvu()) {
      const stat=readStatData(),value=(window.CxxQuests?.actor?window.CxxQuests.actor(stat).wallet:stat?.terminal?.ensemble?null:stat?.terminal?.wallet)?.yen;
      if ((typeof value!=='number' && typeof value!=='string') || String(value).trim()==='') return null;
      const amount=Number(value); return Number.isFinite(amount)?amount:null;
    }
    return Number(demoLedger().wallet) || 0;
  }
  function completedQuestCount(excludeId) {
    return (data.quests || []).filter(q => q.id !== excludeId && questRecord(q.id).state === '完成').length;
  }
  function heistUnlocked() {
    return completedQuestCount('q_heist') >= 2;
  }
  function questLocked(q) {
    if(q.id==='q_heist'&&questRecord(q.id).state==='已发布'&&data.quests.some(q=>q.id==='q_chip_night'))return true;
    return (q.id === 'q_heist' && !heistUnlocked()) || (q.prerequisites || []).some(id => questRecord(id).state !== '完成');
  }

  const readingPositions = new Map();
  const reducedQuery = matchMedia('(prefers-reduced-motion: reduce)');
  const mobileQuery = matchMedia('(max-width: 680px)');
  function element(tag, className, text) {
    const el = document.createElement(tag);
    if (className) el.className = className;
    if (text !== undefined) el.textContent = text;
    return el;
  }
  function button(text, className, handler) {
    const el = element('button', className, text);
    el.type = 'button';
    el.addEventListener('click', handler);
    return el;
  }

  const iconPaths = {
    city: 'M3 5 9 3 15 5 21 3V19L15 21 9 19 3 21ZM9 3V19M15 5V21M5 13H7M17 9H19',
    operations: 'M4 4H10L12 2 14 4H20V21H4ZM8 9H17M8 13H17M8 17H14M9 4V6H15V4',
    network: 'M4 12A8 8 0 0 1 20 12M7 12A5 5 0 0 1 17 12M10 12A2 2 0 0 1 14 12M12 13V21M9 21H15',
    characters: 'M12 3 16 5V10L12 13 8 10V5ZM6 21V17L10 14H14L18 17V21M3 8V3H7M17 3H21V8M3 17V21H7M17 21H21V17',
    media: 'M3 4H21V20H3ZM7 4V20M17 4V20M3 8H7M3 12H7M3 16H7M17 8H21M17 12H21M17 16H21M10 9 14 12 10 15Z',
    archive: 'M4 4H20V20H4ZM4 8H20M4 12H20M4 16H20M7 6H8M7 10H8M7 14H8M7 18H8',
    settings: 'M5 3V21M12 3V21M19 3V21M2 8H8M9 16H15M16 10H22'
  };
  function systemIcon(id) {
    const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    icon.setAttribute('viewBox', '0 0 24 24'); icon.setAttribute('aria-hidden', 'true');
    const shape = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    shape.setAttribute('d', iconPaths[id]); icon.append(shape); return icon;
  }
  let sectionAnimations = [];
  function stopPageMotion() {
    sectionAnimations.forEach(animation => animation.cancel()); sectionAnimations = [];
  }
  // Section pages (DESIGN.md 10.11): rows slide in from the left, the detail panel from the right,
  // and the tab underline slides to the current tab. Yellow wipes from the left, night only fades.
  const inkPlaces = new Map();
  function placeInk(tabs, animate, theme) {
    const current = tabs.querySelector('button[aria-pressed=true]');
    if (!current || !current.offsetWidth) return;
    let ink = tabs.querySelector('.sec-tabs-ink');
    if (!ink) { ink = element('i', 'sec-tabs-ink'); ink.setAttribute('aria-hidden', 'true'); tabs.append(ink); }
    const key = tabs.getAttribute('aria-label') || '', next = { left: current.offsetLeft, width: current.offsetWidth }, prev = inkPlaces.get(key);
    const position=()=>{ink.style.left=next.left+'px';ink.style.width=next.width+'px';tabs.dataset.ink='';inkPlaces.set(key,next);};
    if(motion.available){if(animate&&prev)void motion.layout([ink],position);else position();return;}
    position();
    if (animate && prev && (prev.left !== next.left || prev.width !== next.width)) ink.animate([{ transform: 'translateX(' + (prev.left - next.left) + 'px) scaleX(' + prev.width / next.width + ')' }, { transform: 'none' }], { duration: theme === 'yellow' ? 120 : 200, easing: 'cubic-bezier(.23,1,.32,1)' });
  }
  function sectionMotion(kind, page) {
    if (!page || page.hidden) return;
    const allowed = rootEl.dataset.motion === 'full' && !!page.animate, theme = document.documentElement.dataset.cxxTheme || 'red';
    page.querySelectorAll('.sec-tabs').forEach(tabs => placeInk(tabs, allowed && kind !== 'enter' && theme !== 'night', theme));
    if(motion.available){
      if(!['enter','tab','select'].includes(kind)||rootEl.dataset.motion==='off')return;
      const rows=kind==='select'?[]:[...page.querySelectorAll('.sec-list>:is(.sec-row,.sec-group)')].filter(n=>n.getClientRects().length).slice(0,rootEl.dataset.motion==='reduced'?4:8);
      rows.forEach((node,i)=>void motion.animate(node,theme==='yellow'?[{clipPath:'inset(0 100% 0 0)'},{clipPath:'inset(0 0 0 0)'}]:theme==='night'?[{opacity:.5},{opacity:1}]:[{opacity:.2,transform:'translateX(-8px)'},{opacity:1,transform:'none'}],{channel:'row',duration:180,delay:i*16,fill:'backwards'}));
      if(kind==='select'){const panel=[...page.querySelectorAll('.sec-detail,.sec-panel:not([hidden])')].find(n=>n.getClientRects().length);if(panel)void motion.animate(panel,[{opacity:.45,transform:'translateX(8px)'},{opacity:1,transform:'none'}],{channel:'detail',duration:180});}
      return;
    }
    if (!allowed || !['enter', 'tab', 'select'].includes(kind)) return;
    sectionAnimations.forEach(animation => animation.cancel()); sectionAnimations = [];
    const visible = node => node.getClientRects().length > 0, ease = 'cubic-bezier(.23,1,.32,1)';
    const panel = [...page.querySelectorAll('.sec-detail, .sec-panel:not([hidden])')].find(visible);
    const rows = kind === 'select' ? [] : [...page.querySelectorAll('.sec-list>:is(.sec-row,.sec-group)')].filter(visible).slice(0, 14);
    const wipe = [{ clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0 0 0)' }], fade = [{ opacity: 0 }, { opacity: 1 }];
    const rowFrames = theme === 'yellow' ? wipe : theme === 'night' ? fade : [{ opacity: 0, transform: 'translateX(-16px)' }, { opacity: 1, transform: 'none' }];
    const panelFrames = theme === 'yellow' ? wipe : theme === 'night' ? fade : [{ opacity: 0, transform: 'translateX(24px)' }, { opacity: 1, transform: 'none' }];
    const time = theme === 'yellow' ? 180 : theme === 'night' ? 160 : 200;
    rows.forEach((row, index) => sectionAnimations.push(row.animate(rowFrames, { duration: time, delay: Math.min(index * 24, 300), easing: ease, fill: 'backwards' })));
    if (panel) sectionAnimations.push(panel.animate(panelFrames, { duration: theme === 'red' ? 240 : time, easing: ease }));
  }

  const dialogTurns=new WeakMap();
  function openDialog(node){dialogTurns.set(node,(dialogTurns.get(node)||0)+1);node.hidden=false;node.showModal();void motion.presence(node,true,{distance:12});}
  function closeDialog(node){const turn=(dialogTurns.get(node)||0)+1;dialogTurns.set(node,turn);void motion.presence(node,false,{distance:12}).then(()=>{if(dialogTurns.get(node)!==turn)return;node.close();node.hidden=false;});}
  function announce(text) { $('live-message').textContent = text; }
  function save() {
    try {
      localStorage.setItem(storageKey, JSON.stringify({
        prefs
      }));
      $('motion-status').textContent = reducedQuery.matches ? '系统已要求减少动态效果。' : '显示偏好已保存。';
    } catch { $('motion-status').textContent = '浏览器未允许保存；当前页面仍可使用这些设置。'; }
  }
  function applyPrefs() {
    const chosen=parent.Cxx236Preferences?.read().level||'medium';
    prefs.motion=({high:'full',medium:'reduced',low:'off'})[chosen];
    rootEl.dataset.motion = reducedQuery.matches?'off':prefs.motion;
    rootEl.style.setProperty('--read-size', prefs.font + 'px');
    emitApp({preferences:true});
    rootEl.style.setProperty('--texture', prefs.texture / 100);
    $('font-size').value = prefs.font;
    $('font-value').textContent = prefs.font + ' px';
    $('texture').value = prefs.texture;
    $('texture-value').textContent = prefs.texture + '%';
    $('restore-view').checked = prefs.restore;
    rootEl.querySelectorAll('#t2051x-motion-options button').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.motion === prefs.motion)));
    $('motion-status').textContent = reducedQuery.matches ? '系统已要求减少动态效果。' : '高、中、低特效在本聊天的所有界面中共用。';
    
    stopPageMotion();
  }
  function switchPage(id,options={}) {
    const config=modules.find(m=>m.id===id);if(!config)return false;const changedPage=state.page!==id;
    const previous=pageNode(state.page),from=changedPage?motion.capture(previous):null,direction=options.direction||Math.sign(modules.findIndex(m=>m.id===id)-modules.findIndex(m=>m.id===state.page))||1;
    if(state.page!==id){saveView();if(!options.replace){history.push(state.page);if(history.length>30)history.shift();}stopNetwork();stopPageMotion();}
    state.page=id;rootEl.dataset.route=groupOf(id);$('terminal').dataset.page=id;
    $('scene-word').textContent={city:'ATLAS',operations:'OPS',network:'NET',characters:'IDENTITY',media:'MEMORY',archive:'ARCHIVE',settings:'SYSTEM'}[id];
    for(const name of ['city','archive','settings'])$('page-'+name).hidden=id!==name;
    document.getElementById('t2051x-page-other').hidden=true;
    for(const [name,entry]of moduleViews){if(name!==id)entry.hide?.();entry.root.hidden=true;entry.player?.setVisible(false);}
    if(config.tabs){let entry=moduleViews.get(id);if(!entry){const root=element('section','page other-page cxx-module-page');root.id='terminal-module-'+id;root.dataset.module=id;$('workspace').append(root);entry={root,dirty:false,update:null,signature:lastSignatures[id]};moduleViews.set(id,entry);activeModulePage=root;stats.created++;renderModule(config);}else activeModulePage=entry.root;entry.root.hidden=false;entry.player?.setVisible(terminalVisible);if(!entry.shown){entry.shown=true;requestAnimationFrame(()=>{(entry.root.querySelector('.module-content')||entry.root).scrollTop=viewState.scroll[id]||0;});}if(entry.dirty){entry.dirty=false;entry.update?.();}if(options.tab)entry.select?.(options.tab);}
    if(id==='archive'&&!$('archive-grid').children.length){const index=viewState.archive?.index||0;renderArchive();positionArchive(index);}
    if(id==='archive')$('page-archive').dataset.view='list';
    rootEl.querySelectorAll('.nav-item').forEach(b=>{if(b.dataset.page===groupOf(id))b.setAttribute('aria-current','page');else b.removeAttribute('aria-current');});
    if(changedPage)void motion.navigate(previous,pageNode(id),{from,direction,container:$('workspace')});
    $('footer-name').textContent=config.en;emitApp({route:true});if(changedPage)requestAnimationFrame(()=>{if(state.page===id)$('workspace').scrollTop=viewState.workspace?.[id]||0;});
    if(changedPage||options.replace)requestAnimationFrame(()=>{if(state.page===id)sectionMotion('enter',id==='archive'?$('page-archive'):moduleViews.get(id)?.root);});scheduleView();return true;
  }
  function openQuest(id) {
    if (!QUESTS_AVAILABLE) { announce('委托功能待更新，暂不可用。'); return false; }
    if (!data.quests?.some(q => q.id === id)) { announce('这份任务暂不可用，请查看当前行动列表。'); return false; }
    state.questId = id;
    switchPage('operations');
    moduleViews.get('operations')?.journal?.select(id);
    return true;
  }
  mainModules.forEach(config => {
    const b = button('', 'nav-item', () => switchPage(config.id));
    b.dataset.page = config.id;
    b.setAttribute('aria-label', config.name);
    const icon = element('span', 'nav-icon'); icon.append(systemIcon(config.id)); b.append(icon);
    const serial = element('span', 'nav-serial', String(mainModules.indexOf(config) + 1).padStart(2, '0')); serial.setAttribute('aria-hidden', 'true'); b.append(serial);
    const label = element('span');
    label.append(element('strong', '', config.name), element('small', '', config.en));
    b.append(label);
    $('system-nav').append(b);
  });
  $('system-nav').addEventListener('keydown', e => {
    const current = e.target.closest('button[data-page]');
    if (!current || !['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(e.key)) return;
    e.preventDefault();
    const index = mainModules.findIndex(m => m.id === current.dataset.page);
    const next = e.key === 'Home' ? 0 : e.key === 'End' ? mainModules.length - 1 : (index + (['ArrowLeft', 'ArrowUp'].includes(e.key) ? -1 : 1) + mainModules.length) % mainModules.length;
    switchPage(mainModules[next].id);
    $('system-nav').querySelector('[data-page=' + mainModules[next].id + ']').focus();
  });
  function renderModule(config) {
    const page = $('page-other');
    if(config.id==='characters'){renderCharacterModule(page);return;}
    if(config.id==='operations'){renderQuestModule(page);return;}
    if(config.id==='network'){renderNetworkModule(page);return;}
    moduleViews.get(config.id).commsStop?.();
    // The image collection shares the archive head: library tabs, then its own categories.
    page.replaceChildren(); page.dataset.module = config.id; page.classList.add('sec-page', 'media-page');
    const head = element('header', 'sec-head'), title = element('div', 'sec-title');
    const h = element('h1', '', '资料库'); h.id = 't2051x-other-title'; title.append(element('small', 'sec-eyebrow', 'ARCHIVE / ' + config.name), h);
    const library = element('nav', 'sec-tabs'); library.setAttribute('aria-label', '资料库');
    for (const [id, label] of [['archive', '文字档案'], ['media', '影像收藏']]) { const b = button(label, '', () => { if (id !== config.id) switchPage(id); }); b.setAttribute('aria-pressed', String(id === config.id)); library.append(b); }
    head.append(title, element('span', 'sec-grow'), library);
    const body = element('div', 'module-content'), tabs = element('nav', 'sec-tabs media-tabs');
    tabs.setAttribute('aria-label', config.name + '分类');
    const empty = element('div', 'empty-records');
    const stage = element('div', 'module-stage');
    stage.append(empty);
    const tabLabel = element('p', 'eyebrow', config.tabs[0]);
    empty.append(tabLabel, element('h2', '', config.empty), element('p', '', config.description));
    empty.append(button('查看城市档案 ↗', 'text-button', () => switchPage('archive')));
    const galleryRoot = config.id === 'media' && data.gallery?.characters?.length ? buildGalleryPanel() : null;
    const questRoot = QUESTS_AVAILABLE && config.id === 'operations' && data.quests?.some(q => q.track !== 'main') ? null : null;
    const mainRoot = QUESTS_AVAILABLE && config.id === 'operations' && data.quests?.some(q => q.track === 'main') ? null : null;
    let historyRoot = null;
    let detailPanel = null;
    const customPanel = questRoot || galleryRoot;
    const customIndex = config.customTab ?? 0;
    if (questRoot) { stage.classList.add('has-gallery'); stage.append(questRoot); }
    if (mainRoot) { stage.classList.add('has-gallery'); stage.append(mainRoot); }
    if (galleryRoot) { stage.classList.add('has-gallery'); galleryRoot.classList.add('sec-panel'); stage.append(galleryRoot); }
    const chooseNow = (index, animate = true) => {
      if(config.id==='operations'&&!QUESTS_AVAILABLE&&index<2)return;
      if(config.id==='media'){moduleViews.get('media').request?.abort();moduleViews.get('media').request=null;}
      selectedModuleTabs[config.id]=index;
      page.dataset.category = index;
      tabs.querySelectorAll('button').forEach((tab, i) => tab.setAttribute('aria-pressed', String(i === index)));
      tabLabel.textContent = config.tabs[index];
      let panelShown = false;
      if (config.id === 'operations') {
        if (index === 2) { historyRoot?.remove(); historyRoot = null; stage.append(historyRoot); }
        if (questRoot) questRoot.hidden = index !== 1;
        if (mainRoot) mainRoot.hidden = index !== 0;
        if (historyRoot) historyRoot.hidden = index !== 2;
        panelShown = !!((index === 0 && mainRoot) || (index === 1 && questRoot) || index === 2);
      } else if(config.id==='media' && index>0){
        if(galleryRoot)galleryRoot.hidden=true;
        detailPanel?.remove();detailPanel=index===3?buildStoryAlbum():buildEventPanel(index===1?'event':'scene');
        detailPanel.classList.add('sec-panel');stage.append(detailPanel);panelShown=true;
      } else if (customPanel) {
        detailPanel?.remove();detailPanel=null;
        const showCustom = index === customIndex;
        customPanel.hidden = !showCustom;
        panelShown = showCustom;
      }
      stage.classList.toggle('has-content', panelShown);
      empty.style.display = panelShown ? 'none' : '';
      sectionMotion(animate ? 'tab' : 'sync', page); if (animate) announce('已选择' + config.tabs[index]);
      if (animate&&config.tabs) body.scrollTop = 0;scheduleView();
    };
    const choose=(index,animate=true)=>{const previous=selectedModuleTabs[config.id]||0;return animate?motion.update(stage,()=>chooseNow(index,true),{direction:Math.sign(index-previous)||1}):chooseNow(index,false);};
    function buildStoryAlbum(){
      const root=element('div','event-panel'),pictures=window.parent.CxxPlot?.album?.(readStatData()||{})||[];
      root.append(element('p','eyebrow','STORY ILLUSTRATIONS / 剧情插图'));
      if(!pictures.length){root.append(element('h2','','这里还没有剧情插图'),element('p','','已装载的剧情暂未配置插图。'));return root;}
      const groups=new Map();for(const picture of pictures){if(!groups.has(picture.lineId))groups.set(picture.lineId,[]);groups.get(picture.lineId).push(picture);}
      for(const rows of groups.values()){
        const group=element('section','story-art-group'),grid=element('div','event-grid'),unlocked=rows.filter(p=>!p.locked&&p.url);
        group.setAttribute('aria-label',rows[0].lineTitle);group.append(element('h3','',rows[0].lineTitle),grid);
        for(const picture of rows){
          const code=String(pictures.indexOf(picture)+1).padStart(2,'0');
          if(picture.locked){const item=element('div','event-card story-art-card is-locked'),lock=element('div','story-art-lock');lock.append(element('span','story-art-code',code),element('p','','未解锁'));item.append(lock);item.setAttribute('aria-label','剧情插图 '+code+'，未解锁');grid.append(item);continue;}
          const b=button('','event-card story-art-card',()=>openViewer(picture.lineTitle,unlocked.map(p=>p.url),unlocked.indexOf(picture),b)),img=element('img');img.alt=picture.caption;img.loading='lazy';img.decoding='async';b.setAttribute('aria-label',picture.caption);
          if(contentClient)contentClient.bindImage(img,picture.url);else img.src=picture.url;
          img.addEventListener('error',()=>{img.hidden=true;b.append(element('p','','图片暂不可用，解锁记录仍保留。'));},{once:true});b.append(img,element('h3','',picture.caption));grid.append(b);
        }
        root.append(group);
      }
      return root;
    }
    function buildEventPanel(category){
      const entry=moduleViews.get('media');entry.request?.abort();const request=entry.request=new AbortController();entry.hide=()=>{if(entry.request){entry.request.abort();entry.request=null;entry.dirty=true;}};
      const root=element('div','event-panel'),stamp=JSON.stringify(readStatData()?.terminal?.gameplay?.events || {});
      root.append(element('p','setting-note','正在核对已保存的影像记录…'));
      Promise.resolve(contentClient?.savedEventMedia?.({signal:request.signal}) || []).then(all=>{
      if(request.signal.aborted||!root.isConnected || stamp!==JSON.stringify(readStatData()?.terminal?.gameplay?.events || {}))return;
      const media=all.filter(m=>m.category===category);root.replaceChildren();
      root.append(element('p','eyebrow','SAVED MEMORIES / 已解锁影像'));
      if(!media.length){root.append(element('h2','','这里还没有已解锁的影像'),element('p','','完成对应事件并保存后，可在这里重看已解锁的插画。'));return root;}
      const grid=element('div','event-grid');media.forEach((m,i)=>{const b=button('','event-card',()=>openViewer(m.name,media.map(x=>x.url),i,b)),img=element('img');img.loading='lazy';img.alt=m.alt;contentClient.bindImage(img,m.url);img.addEventListener('error',()=>{img.hidden=true;b.append(element('p','','图片暂不可用，已保留解锁记录。'));},{once:true});b.append(img,element('h3','',m.name));grid.append(b);});root.append(grid);
      }).catch(e=>{if(!request.signal.aborted&&root.isConnected)root.replaceChildren(element('p','setting-note',e.message));}).finally(()=>{if(entry.request===request)entry.request=null;});return root;
    }
    function nsfwAllowed() {
    try {
      const P = parent?.Cxx236Preferences || globalThis.Cxx236Preferences;
      if (P && typeof P.read === 'function' && typeof getVariables === 'function') return P.read(getVariables({ type: 'chat' }))?.nsfw === true;
      if (typeof getVariables === 'function') return getVariables({ type: 'chat' })?.['__cxx_ui_preferences']?.nsfw === true;
    } catch { /* 未在酒馆内运行时按关闭处理 */ }
    return false;
  }
  function buildGalleryPanel() {
      const chars = data.gallery.characters;
      try { if (!buildGalleryPanel.listening) { buildGalleryPanel.listening = true; parent.addEventListener('cxx-ui-preferences-changed', () => { try { renderGrid(); } catch { /* 面板已卸载 */ } }); } } catch { /* 跨域或已卸载 */ }
      const catLabel = key => key === 'standard' ? '立绘' : key === 'daily' ? '日常' : '瑟瑟';
      const root = element('div', 'gallery-root');
      const head = element('div', 'gallery-head');
      head.append(element('p', 'eyebrow', 'CHARACTER ILLUSTRATION INDEX'));
      const deck = element('div', 'gallery-deck'); deck.setAttribute('role', 'group'); deck.setAttribute('aria-label', '角色插画档案卡流');
      chars.forEach((ch, index) => {
        const countsText = '立绘 ' + ch.standard.length + ' · 日常 ' + ch.daily.length + ((ch.nsfw || []).length ? ' · 瑟瑟 ' + ch.nsfw.length : '');
        const b = button('', 'gallery-card', () => positionGalleryDeck(index, true));
        b.setAttribute('aria-label', ch.name + '，' + countsText);
        const cover = element('div', 'gallery-cover'); cover.setAttribute('aria-hidden', 'true');
        cover.style.backgroundImage = 'url("' + ch.av + '")';
        cover.append(element('span', 'gallery-cover-code', String(index + 1).padStart(2, '0')), element('span', 'gallery-cover-label', ch.en));
        b.append(cover, element('h3', '', ch.name), element('small', '', countsText));
        deck.append(b);
      });
      const controls = element('div', 'deck-controls');
      const pos = element('span', '', ''); pos.setAttribute('role', 'status');
      const prev = button('←', '', () => positionGalleryDeck(galleryIndex - 1, true)); prev.setAttribute('aria-label', '上一位角色');
      const next = button('→', '', () => positionGalleryDeck(galleryIndex + 1, true)); next.setAttribute('aria-label', '下一位角色');
      controls.append(prev, pos, next);
      const detail = element('div', 'gallery-detail');
      const chips = element('div', 'gallery-cats'); chips.setAttribute('role', 'group'); chips.setAttribute('aria-label', '插画分类');
      const galleryCats = [['standard', '立绘'], ['daily', '日常']];
      if (chars.some(ch => (ch.nsfw || []).length)) galleryCats.push(['nsfw', '瑟瑟']);
      galleryCats.forEach(([key, label]) => {
        const b = button(label, '', () => { galleryCat = key; renderGrid(); });
        b.dataset.cat = key; chips.append(b);
      });
      const info = element('p', 'gallery-info'); info.setAttribute('role', 'status');
      const grid = element('div', 'gallery-grid');
      detail.append(chips, info, grid);
      root.append(head, deck, controls, detail);
      function positionGalleryDeck(index, focus = false) {
        galleryIndex = (index + chars.length) % chars.length;
        deck.querySelectorAll('.gallery-card').forEach((card, i) => {
          let slot = i - galleryIndex;
          if (slot > chars.length / 2) slot -= chars.length;
          if (slot < -chars.length / 2) slot += chars.length;
          const depth = Math.abs(slot);
          card.hidden = depth > 3;
          card.style.setProperty('--slot', slot); card.style.setProperty('--depth', depth);
          card.style.zIndex = 10 - depth;
          card.setAttribute('aria-pressed', String(slot === 0)); card.tabIndex = slot === 0 ? 0 : -1;
        });
        pos.textContent = String(galleryIndex + 1).padStart(2, '0') + ' / ' + String(chars.length).padStart(2, '0');
        renderGrid();
        if (focus) deck.querySelector('[aria-pressed=true]')?.focus({ preventScroll: true });
      }
      function renderGrid() {
        const ch = chars[galleryIndex], list = ch[galleryCat] || [];
        chips.querySelectorAll('button').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.cat === galleryCat)));
        info.textContent = ch.name + ' · ' + catLabel(galleryCat) + ' ' + list.length + ' 张';
        grid.replaceChildren();
        const locked = galleryCat === 'nsfw' && !nsfwAllowed();
        if (locked) info.textContent = ch.name + ' · ' + catLabel(galleryCat) + ' ' + list.length + ' 张 · 未开启（在设置里打开 NSFW 内容后可见）';
        list.forEach((url, i) => {
          if (locked) {
            const b = button('', 'gallery-thumb is-locked', () => { info.textContent = 'NSFW 内容未开启：请打开卡内「设置 ← 内容尺度」开启后再看。'; });
            b.setAttribute('aria-label', ch.name + ' ' + catLabel(galleryCat) + ' ' + (i + 1) + '，未开启 NSFW 内容');
            const shell = document.createElement('span');
            shell.textContent = '未开启';
            shell.style.cssText = 'display:flex;align-items:center;justify-content:center;width:100%;height:100%;min-height:96px;font-size:12px;letter-spacing:.08em;color:var(--ink-dim,#8a8a95);border:1px dashed var(--line,#3a3a44);border-radius:6px';
            b.append(shell); grid.append(b); return;
          }
          const b = button('', 'gallery-thumb', () => openViewer(ch.name + ' · ' + catLabel(galleryCat), list, i, b));
          b.setAttribute('aria-label', ch.name + ' ' + catLabel(galleryCat) + ' ' + (i + 1) + '，打开查看器');
          const img = document.createElement('img');
          img.loading = 'lazy'; img.decoding = 'async'; img.alt = '';
          if (contentClient) contentClient.bindImage(img, url, data.assetMeta?.[url]); else img.src = url;
          if (img.complete && img.naturalWidth > 0) img.classList.add('loaded');
          else img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
          b.append(img); grid.append(b);
        });
      }
      deck.addEventListener('keydown', e => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key) || !e.target.closest('.gallery-card')) return;
        e.preventDefault();
        positionGalleryDeck(e.key === 'Home' ? 0 : e.key === 'End' ? chars.length - 1 : galleryIndex + (e.key === 'ArrowLeft' ? -1 : 1), true);
      });
      positionGalleryDeck(galleryIndex);
      return root;
    }
  // ===== 网路连接（独立演算）配置：只存本机，独立于显示偏好 =====
  async function netRefreshDynamic(statusLine) {
    const service=newsService(),request={controller:new AbortController()};netRequest=request;
    try{if(!service)throw Error('总结新闻服务尚未就绪，请检查本卡核心脚本。');const ok=await service.refresh({signal:request.controller.signal});if(request.controller.signal.aborted)return false;if(statusLine)statusLine.textContent=service.state({light:true}).status;return ok;}
    catch(e){if(!request.controller.signal.aborted&&statusLine)statusLine.textContent=e.message;return false;}
    finally{if(netRequest===request)netRequest=null;}
  }
  // ===== 通讯页（DESIGN.md 10.11）：联系人、邮件、城市消息，各为列表＋详情 =====
  function renderNetworkModule(page) {
    const entry = moduleViews.get('network');
    entry.commsStop?.(); entry.commsStop = null;
    netRadioView?.destroy(); netRadioView = null;
    page.replaceChildren(); page.dataset.module = 'network';
    const root = element('section', 'sec-page net-page'); root.dataset.view = 'list';
    const head = element('header', 'sec-head'), title = element('div', 'sec-title'), h = element('h1', '', '通讯');
    h.id = 't2051x-other-title'; title.append(element('small', 'sec-eyebrow', 'NETWORK / 通讯'), h);
    const tabs = element('nav', 'sec-tabs'); tabs.setAttribute('aria-label', '通讯分区');
    const figure = element('div', 'sec-figure'), figureLabel = element('small'), figureValue = element('strong'); figure.append(figureLabel, figureValue);
    head.append(title, element('span', 'sec-grow'), tabs, figure);
    const body = element('div', 'net-view'); root.append(head, body); page.append(root);
    const views = [['contacts', '联系人'], ['mail', '邮件'], ['city', '城市消息']];
    let current = views.some(v => v[0] === viewState.comms) ? viewState.comms : 'contacts', cityTab = Math.min(2, Number(selectedModuleTabs.network) || 0);
    const pick = { contact: null, mail: null, news: null, thread: null };
    const phone = () => window.parent.CxxPhone, mailbox = () => window.parent.CxxMailbox;
    const showDetail = () => { void motion.swap(body,()=>{root.dataset.view='detail';}); sectionMotion('select', root); root.querySelector('.net-back')?.focus({ preventScroll: true }); };
    const back = () => { void motion.swap(body,()=>{root.dataset.view='list';},{direction:-1}); root.querySelector('.sec-row[aria-pressed=true]')?.focus({ preventScroll: true }); };
    const backButton = () => button('‹ 返回列表', 'net-back', back);
    const press = (list, selector, id) => list.querySelectorAll(selector).forEach(row => row.setAttribute('aria-pressed', String(row.dataset.id === id)));
    const run = async (fn, status) => { try { await fn(); } catch (e) { (status || { set textContent(v) { announce(v); } }).textContent = e.message; } };
    function columns() { const wrap = element('div', 'sec-body'), list = element('div', 'sec-list sec-list-pane'), detail = element('article', 'sec-detail net-detail'); wrap.append(list, detail); return { wrap, list, detail }; }
    function paintFigure() {
      const contacts = phone()?.read().contacts || [], mail = mailbox()?.state();
      if (current === 'mail') { figureLabel.textContent = '未读'; figureValue.textContent = String(mail?.unread ?? 0); }
      else if (current === 'contacts') { figureLabel.textContent = '已联系'; figureValue.textContent = String(contacts.filter(c => c.active).length); }
      else { figureLabel.textContent = '动态'; figureValue.textContent = String((netDyn().news || []).length + data.news.length); }
      for (const b of tabs.querySelectorAll('button')) if (b.dataset.view === 'mail') b.textContent = '邮件' + (mail?.unread ? ' · ' + mail.unread : '');
    }
    function avatar(contact, cls = 'net-avatar') {
      const holder = element('span', cls, contact.avatar ? '' : contact.name.slice(-1)); holder.setAttribute('aria-hidden', 'true');
      if (contact.avatar) { const img = element('img'); img.alt = ''; img.src = contact.avatar; img.onerror = () => holder.replaceChildren(document.createTextNode(contact.name.slice(-1))); holder.append(img); }
      return holder;
    }
    // Contacts: the phone keeps the conversation; this page lists who can be reached and opens the line.
    function contactsView() {
      const service = phone(), { wrap, list, detail } = columns(); list.setAttribute('aria-label', '联系人列表');
      if (!service) { list.append(element('p', 'sec-empty', '通讯器尚未就绪，请稍后重试。')); detail.hidden = true; return wrap; }
      const snap = service.read(), contacts = [...snap.contacts].sort((a, b) => Number(b.active) - Number(a.active));
      if (!contacts.length) { list.append(element('p', 'sec-empty', '通讯录还是空的。剧情中交换联系方式后，就可以在这里联系。')); detail.hidden = true; return wrap; }
      if (!contacts.some(c => c.id === pick.contact)) pick.contact = (contacts.find(c => c.id === snap.selected) || contacts[0]).id;
      for (const [label, test] of [['已取得联系方式', c => c.active], ['本分支未解锁', c => !c.active]]) {
        const members = contacts.filter(test); if (!members.length) continue;
        list.append(element('p', 'sec-group', label + ' · ' + members.length));
        for (const c of members) {
          const row = button('', 'sec-row net-contact', () => { pick.contact = c.id; press(list, '.net-contact', c.id); paintContact(); showDetail(); });
          row.dataset.id = c.id; row.classList.toggle('is-locked', !c.active);
          row.append(avatar(c), element('strong', '', c.name), element('small', '', c.active ? '已取得联系方式' : '此分支未解锁 · 旧记录保留')); list.append(row);
        }
      }
      press(list, '.net-contact', pick.contact);
      function paintContact() {
        const snap = service.read(), c = snap.contacts.find(x => x.id === pick.contact); detail.replaceChildren(); if (!c) return;
        const scroll = element('div', 'sec-scroll'), person = element('div', 'net-person'), name = element('div'), status = element('p', 'net-note');
        name.append(element('p', 'sec-eyebrow', '私人线路'), element('h2', '', c.name), element('p', 'net-state', c.active ? '已取得联系方式' : '当前分支未解锁 · 旧记录保留'));
        person.append(avatar(c, 'net-avatar is-large'), name); scroll.append(backButton(), person);
        const turns = snap.selected && snap.selected === c.id ? (snap.turns || []).slice(-3) : [];
        if (!c.active) scroll.append(element('p', 'net-note', '这条线路在本分支尚未建立。'));
        else if (!turns.length) scroll.append(element('p', 'net-note', snap.selected === c.id ? '还没有往来记录。打开私聊后可以发消息或拨打语音。' : '打开私聊后，可以查看与' + c.name + '的往来记录。'));
        else { const log = element('div', 'net-log'); log.setAttribute('aria-label', '最近往来'); for (const t of turns) { if (t.input) log.append(element('p', 'net-msg is-mine', t.input)); const reply = element('p', 'net-msg'); reply.append(element('b', '', c.name), document.createTextNode(t.reply || t.error || '等待回复')); log.append(reply); } scroll.append(log); }
        scroll.append(status);
        const actions = element('div', 'sec-actions'), open = async dial => { await service.select(c.id); service.open?.('chat'); if (dial) await service.dial(); };
        const call = button('拨打语音', 'sec-button', () => run(() => open(true), status)); call.disabled = !c.active || !snap.caps?.text || !snap.caps?.call || snap.busy; if (call.disabled && c.active) call.title = '需要先在通讯器设置中配置镜译的通话与声音。';
        const chat = button('打开私聊', 'sec-button is-primary', () => run(() => open(false), status)); chat.disabled = !c.active;
        actions.append(call, chat); detail.append(scroll, actions);
      }
      paintContact(); return wrap;
    }
    // Mail: official notices from the shared inbox; opening one marks it read.
    function mailView() {
      const inbox = mailbox(), { wrap, list, detail } = columns(); list.setAttribute('aria-label', '收件列表');
      if (!inbox) { list.append(element('p', 'sec-empty', '收件箱尚未就绪，请稍后重试。')); detail.hidden = true; return wrap; }
      const s = inbox.state(), items = [...(s.items || [])].sort((a, b) => Date.parse(b.publishedAt) - Date.parse(a.publishedAt)), date = m => new Date(m.publishedAt).toLocaleDateString('zh-CN');
