  let locationCache=null;
  function currentLocationContent(sd){if(locationCache)return locationCache;
    const installed=contentClient?.readHost(),locationBase={...baseData,nodes:atlasLocations.find(m=>m.id==='tokyo-central').places};
    const current=installed?contentClient.view(locationBase,installed.registry,sd?.terminal?.quests||{},{subscriptions:installed.subscriptions,pins:contentClient.chatPins(),mediaPreferences:installed.mediaPreferences,initialContent:installed.initialContent,initialAvatars:installed.initialAvatars}):baseData;
    return locationCache={...current,quests:(current.quests||[]).map(bindLegacyLocation)};
  }
  const hostBridge=window.TOKYO_TERMINAL_HOST=CxxTerminalHost.create({
    getContext:()=>typeof SillyTavern==='undefined'?null:(SillyTavern.getContext?.()||SillyTavern),
    getVariables:options=>typeof getVariables==='function'?getVariables(options):null,
    getLastMessageId:()=>typeof getLastMessageId==='function'?getLastMessageId():-1,
    updateVariablesWith:typeof updateVariablesWith==='function'?updateVariablesWith:undefined,
    busy:()=>window.parent?.__cxx_gal_g1__?.numericBusy?.()===true || (typeof builtin!=='undefined' && builtin.duringGenerating?.()===true),
    revision:()=>contentClient?.readHost()?.contentRevision||'',
    definitions:sd=>(currentLocationContent(sd).quests||[]).map(q=>({...q,locked:questLocked(q)}))
  });
  netState=window.TOKYO_TERMINAL_NEWS=CxxNewsState.create({read:()=>hostBridge.read(),storage:{getItem:key=>{try{return localStorage.getItem(key);}catch{return null;}},setItem:(key,value)=>{try{localStorage.setItem(key,value);}catch{}}}});
  const placeQuestLocked=q=>questRecord(q.id).state==='已发布'&&questLocked(q);
  window.TOKYO_TERMINAL_MAP_LINKS={openQuest:id=>{refreshContent();const q=data.quests?.find(q=>q.id===id);if(!q||placeQuestLocked(q)){announce('这份任务暂不可用，请查看当前行动列表。');return false;}return openQuest(id);},closeTerminal,
    record:(mapId,placeId)=>recordOf({kind:'place',mapId,id:placeId}),
    openArchive:(mapId,placeId)=>window.TOKYO_TERMINAL_MAP_CONTROL.focus(mapId,placeId),
    placeName:(mapId,placeId)=>atlasLocations.find(m=>m.id===(mapId||'tokyo-central'))?.places.find(n=>n.id===placeId)?.name,
    goToQuest:id=>{refreshContent();const q=currentLocationContent(readStatData()).quests?.find(q=>q.id===id);if(!q||placeQuestLocked(q)||!window.TOKYO_TERMINAL_MAP_LINKS.placeName(q.mapId,q.placeId)){announce('这份任务尚无可用的地图地点。');return false;}switchPage('city');return window.TOKYO_TERMINAL_MAP_CONTROL.focus(q.mapId||'tokyo-central',q.placeId);},
    read:(mapId,placeId)=>{
      if(!atlasLocations.find(m=>m.id===mapId)?.places.some(n=>n.id===placeId))return{quests:[],notes:[]};
      const current=currentLocationContent(readStatData());
      return{quests:(current.quests||[]).filter(q=>q.placeId===placeId&&(q.mapId||'tokyo-central')===mapId&&!placeQuestLocked(q)).map(q=>({id:q.id,title:q.title,status:questRecord(q.id).state})),notes:(current.workshopNotes||[]).filter(n=>n.mapId===mapId&&n.placeId===placeId)};
    }
  };
  refreshContent();contentStamp=contentClient?.readHost()?.contentRevision||'';
  window.CxxTerminalBoot?.stage(1,'done');window.CxxTerminalBoot?.log('terminal','read','终端资料',data.nodes.length+' 个地点');window.CxxTerminalBoot?.stage(2,'now');
  installApplication();
  function renderQuestModule(page){
    page.replaceChildren();const entry=moduleViews.get('operations');
    entry.journal=window.CxxQuestUI.mount(page,{
      read:()=>hostBridge.readState().statData||{},definitions:()=>{refreshContent();return [...(data.quests||[])];},
      view:viewState.journal||{},onView:v=>{viewState.journal=v;scheduleView();},
      commit:request=>window.parent.__cxx_player__.commit(request),
      observer:window.parent.__cxx_player__?.quests?.registerView(),
      viewSource:()=>{const c=parent.SillyTavern.getContext(),s=hostBridge.readState();return {chatId:c.getCurrentChatId(),characterId:c.characterId,floor:s.sourceFloor,swipe:c.chat[s.sourceFloor]?.swipe_id||0};},
      source:()=>{const quests=window.parent.__cxx_player__?.quests;if(!quests?.source)throw Error('任务保存服务尚未就绪，请等待剧情核心加载完成。');return quests.source();},
      compose:(q,r)=>{const top=window.parent,input=top.document.querySelector('#send_textarea');if(!input)throw Error('正文输入框尚未就绪。');if(input.value.trim())throw Error('行动输入框已有草稿，已保留。请先发送或清空原草稿。');input.value='我准备继续'+(q.chapterId?'章节':'委托')+'「'+q.title+'」。当前目标：'+(r.objective||q.goal)+'\n委托人：'+(q.fixer||'原委托人')+'。简报：'+(q.brief||'按已知记录继续')+'\n请承接已保存进展与我的行动，不重复发放已经收到的款项。';input.dispatchEvent(new top.Event('input',{bubbles:true}));},
      map:id=>window.TOKYO_TERMINAL_MAP_LINKS.goToQuest(id),
      motion:(kind,root)=>sectionMotion(kind,root)
    });entry.update=()=>{entry.journal.refresh();stats.updates++;};entry.select=id=>entry.journal.select(id);
  }
  function renderCharacterModule(page){
    page.classList.add('terminal-player','sec-page');const head=element('header','sec-head player-head'),title=element('div','sec-title');title.append(element('small','sec-eyebrow','PLAYER / 人物档案'),element('h1','','人物'));
    const tabs=element('nav','sec-tabs');tabs.setAttribute('aria-label','人物分类');head.append(title,element('span','sec-grow'),tabs);
    const body=element('div','terminal-player-body');page.append(head,body);
    const service=window.parent.__cxx_player__,entry=moduleViews.get('characters');
    if(service)entry.player=service.mount(body,viewState.player?.tab||'人物',{navigation:false,appearanceStyle:window.CxxTerminalPlayerStyle,viewState:viewState.player,onViewChange:value=>{if(value?.tab){for(const b of tabs.querySelectorAll('button'))b.setAttribute("aria-pressed",String(b.textContent===value.tab));sectionMotion('tab',page);}scheduleView();}});
    else body.append(element('p','setting-note','人物服务尚未就绪，请重新打开终端。'));
    const select=async tab=>{if(tab==='行动记录'){if(await entry.player?.canLeave?.()===false)return;switchPage('operations');return;}await entry.player?.setTab(tab);const current=entry.player?.readViewState?.().tab||tab;for(const b of tabs.querySelectorAll('button'))b.setAttribute('aria-pressed',String(b.textContent===current));sectionMotion('sync',page);scheduleView();};
    for(const tab of ['人物表','人物','天赋','物品栏','义体','行动记录'])tabs.append(button(tab,'',()=>select(tab)));
    entry.select=select;entry.update=()=>{entry.player?.refresh();stats.updates++;};select(viewState.player?.tab||'人物');
  }
  function installApplication(){
    const connection=rootEl.querySelector('.connection');if(connection){connection.textContent='STORY ARCHIVE · 当前故事';connection.setAttribute('aria-label','当前故事档案');}
        const historyBack=button('← 人物档案','quiet',()=>switchPage('characters'));historyBack.classList.add('terminal-history-back');$('workspace').prepend(historyBack);
    appListeners.add(()=>{historyBack.hidden=state.page!=='operations';});
    const archived=viewState.archive;if(archived){archiveKind=['city','setting','library'].includes(archived.kind)?archived.kind:'city';archiveIndex=Number(archived.index)||0;$('archive-search').value=archived.query||'';}
    for(const name of ['input','change'])rootEl.addEventListener(name,scheduleView);
    rootEl.addEventListener('scroll',scheduleView,{capture:true,passive:true});
    window.CxxTerminalApp={motion,navigate:switchPage,close:closeTerminal,saveView,state:viewState,
      get visible(){return terminalVisible&&!$('terminal').hidden;},get page(){return state.page;},
      subscribe(fn){appListeners.add(fn);return()=>appListeners.delete(fn);},
      open(route={}){boot();terminalVisible=true;$('terminal').hidden=false;switchPage(route.page||'city',{replace:true,tab:route.tab});checkContent();useHostViewport(false);emitApp({route:true});},
      invalidate(event){hostBridge.changed();locationCache=null;checkContent(event);},
      back(){const id=history.pop();if(id)switchPage(id,{replace:true,direction:-1});else closeTerminal();},
      read:()=>({...stats,motion:motion.diagnostics(),pages:[...moduleViews.keys()],page:state.page,visible:terminalVisible}),
      canLeave:()=>state.page==='characters'?moduleViews.get('characters')?.player?.canLeave?.()??true:true,
      destroy(){motion.dispose();netRadioView?.destroy();netRadioView=null;clearTimeout(viewTimer);saveView();stopNetwork();stopPageMotion();releaseHostViewport();for(const e of moduleViews.values()){e.hide?.();e.commsStop?.();e.player?.destroy();e.journal?.destroy();}moduleViews.clear();appListeners.clear();}
    };
    const oldOpening=button('开场设置','quiet',()=>{const opening=window.parent.Cxx236OpeningHost;if(opening?.hasUnconfirmed?.()){closeTerminal();opening.open();}else announce('开场设置位于新聊天的六步开场；已建档人物请使用人物页。');});
    document.querySelector('.settings-form')?.append(oldOpening);
    window.addEventListener('pagehide',()=>window.CxxTerminalApp.destroy(),{once:true});
  }

})();
