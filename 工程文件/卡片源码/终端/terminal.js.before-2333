    $('archive-map').hidden = region;
    $('archive-read').textContent = region ? '阅读当前档案 ↗' : '在地图中打开 ↗';
    showArchiveFigure(record);
    scheduleView();
    if (focus) $('archive-grid').querySelector('.archive-row[aria-pressed=true]')?.focus({ preventScroll: true });
  }
  const stepArchive = step => { void motion.swap($('archive-selection'),()=>positionArchive(archiveIndex+step),{direction:step}); $('archive-grid').querySelector('.archive-row[aria-pressed=true]')?.scrollIntoView({ block: 'nearest' }); sectionMotion('select', $('page-archive')); };
  $('archive-prev').addEventListener('click', () => stepArchive(-1));
  $('archive-next').addEventListener('click', () => stepArchive(1));
  $('archive-read').addEventListener('click', () => { if (archiveItems.length) openReader(archiveItems[archiveIndex].selection, $('archive-read')); });
  $('archive-map').addEventListener('click', () => { const current = archiveItems[archiveIndex]; if (current?.selection.kind === 'place') openReader(current.selection, $('archive-map')); });
  $('archive-back').addEventListener('click', () => { void motion.swap($('archive-grid'),()=>{$('page-archive').dataset.view='list';},{direction:-1}); $('archive-grid').querySelector('.archive-row[aria-pressed=true]')?.focus({ preventScroll: true }); });
  $('archive-grid').addEventListener('keydown', e => {
    if (!['ArrowUp', 'ArrowDown', 'Home', 'End'].includes(e.key) || !e.target.closest('.archive-row')) return;
    e.preventDefault();
    positionArchive(e.key === 'Home' ? 0 : e.key === 'End' ? archiveItems.length - 1 : archiveIndex + (e.key === 'ArrowUp' ? -1 : 1), true);
  });
  $('archive-search').addEventListener('input', renderArchive);
  rootEl.querySelectorAll('[data-library]').forEach(b => b.addEventListener('click', () => { if (b.dataset.library === 'media') switchPage('media'); }));
  rootEl.querySelectorAll('[data-archive]').forEach(b => b.addEventListener('click', () => { archiveKind = b.dataset.archive; renderArchive(); }));
  function closeTerminal() {terminalVisible=false;for(const e of moduleViews.values()){e.hide?.();e.player?.setVisible(false);}saveView();emitApp({route:true});
    stopNetwork();stopPageMotion();  save(); $('terminal').hidden = true; fitHostViewport(); try { document.getElementById('t2051x-fab').focus({ preventScroll: true }); } catch (_) {}
  }
  $('close-terminal').addEventListener('click', closeTerminal);
  function requestHostTerminal() {
    try {
      const frame = window.frameElement, host = frame?.ownerDocument;
      if (!host || Popover.isOpen(frame)) return false;
      return !host.dispatchEvent(new host.defaultView.CustomEvent('cxx:open-native-terminal', { cancelable: true, detail: { frame } }));
    } catch (_) { return false; }
  }
  let hostChat = null, hostFrame = null, hostResize = null;
  function fitHostViewport() {
    try {
      if (!hostChat || !hostFrame) return;
      const frame = hostFrame.getBoundingClientRect(), chat = hostChat.getBoundingClientRect();
      const full = Popover.isOpen(hostFrame);
      const top = full ? 0 : Math.max(0, chat.top - frame.top);
      const bottom = full ? 0 : Math.max(0, frame.bottom - chat.bottom);
      rootEl.style.setProperty('--t2051x-visible-top', top + 'px');
      rootEl.style.setProperty('--t2051x-visible-bottom', bottom + 'px');
      $('terminal').style.top = top + 'px';
      $('terminal').style.bottom = bottom + 'px';
    } catch (_) { /* 独立页面或跨域宿主沿用 iframe 边界 */ }
  }
  function releaseHostViewport() {
    hostChat?.removeEventListener('scroll', fitHostViewport);
    hostFrame?.removeEventListener('toggle', fitHostViewport);
    hostResize?.disconnect(); hostResize = null;
    try { window.parent.removeEventListener('resize', fitHostViewport); } catch (_) {}
    hostChat = null; hostFrame = null;
    rootEl.style.removeProperty('--t2051x-visible-top'); rootEl.style.removeProperty('--t2051x-visible-bottom');
    $('terminal').style.top = ''; $('terminal').style.bottom = '';
  }
  function useHostViewport(scroll = true) {
    releaseHostViewport();
    try {
      hostFrame = window.frameElement;
      // The shared terminal owns the full visible viewport. Chat clipping is
      // only for old inline embeds, including when a WebView lacks popovers.
      if (hostFrame?.id === 'cxx-shared-terminal-233') return;
      hostChat = hostFrame?.ownerDocument.getElementById('chat');
      if (!hostChat) return;
      if (scroll && !Popover.isOpen(hostFrame)) hostFrame.scrollIntoView({ block: 'start', behavior: 'instant' });
      hostChat.addEventListener('scroll', fitHostViewport, { passive: true });
      hostFrame.addEventListener('toggle', fitHostViewport);
      window.parent.addEventListener('resize', fitHostViewport);
      hostResize = new ResizeObserver(fitHostViewport);
      hostResize.observe(hostChat); hostResize.observe(hostFrame);
      fitHostViewport();
    } catch (_) { /* 不要求宿主同源 */ }
  }
  useHostViewport(false);
  window.addEventListener('pageshow', () => useHostViewport(false));
  let booted = false;
  function boot() {
    if (booted) return; booted = true;
    applyPrefs();
  }
  document.getElementById('t2051x-fab').addEventListener('click', () => {
    if (requestHostTerminal()) return;
    const refresh = booted; boot();
    $('terminal').hidden = false;
    useHostViewport();
    switchPage('city',{replace:true});terminalVisible=true;emitApp({route:true});
    $('system-nav').querySelector('[data-page=' + groupOf(state.page) + ']').focus({ preventScroll: true });
  });
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape' || $('reader').open || $('gallery-viewer').open || $('terminal').hidden) return;
    e.preventDefault();
    if(state.page==='city'&&window.TOKYO_TERMINAL_MAP_CONTROL?.escape())return;
    if(document.documentElement.dataset.cxxEmbedded==='true'){closeTerminal();return;}
    if(state.page!=='city'){switchPage('city');$('system-nav').querySelector('[data-page=city]').focus();}
    else closeTerminal();
  });
  $('motion-options').addEventListener('click', e => {
    const b = e.target.closest('button'); if (!b) return;
    const service=parent.Cxx236Preferences;if(!service){announce('显示设置未就绪');return;}
    service.save({level:({full:'high',reduced:'medium',off:'low'})[b.dataset.motion],gal:service.read().gal}).then(()=>applyPrefs()).catch(e=>announce('特效未保存：'+e.message));
  });
  // 网路连接设置
  function netConnSummary() {
    const c = netCfg();
    return c.apiBase && c.model ? '已配置，模型：' + c.model : '未配置——网路页的「请求新动态」需要它。';
  }
  function loadNetCfgForm() {
    const cfg = netCfg();
    $('net-api').value = cfg.apiBase || '';
    $('net-key').value = cfg.apiKey || '';
    $('net-model').value = cfg.model || '';
    $('net-sync').checked = cfg.syncStory === true;
    $('net-status').textContent = netConnSummary();
  }
  const connectionTools=window.parent.CxxApiConnection||window.CxxApiConnection;
  connectionTools?.mountModels({document,parent:$('net-model').parentElement,fields:{apiBase:$('net-api'),apiKey:$('net-key'),model:$('net-model')},service:newsService});
  ['net-api', 'net-key', 'net-model'].forEach(id => $(id).addEventListener('change', () => {
    saveNetCfg({ apiBase: $('net-api').value.trim(), apiKey: $('net-key').value.trim(), model: $('net-model').value.trim() });
    $('net-status').textContent = netConnSummary();
  }));
  $('net-sync').addEventListener('change', e => {
    saveNetCfg({ syncStory: e.target.checked });
    $('net-status').textContent = netConnSummary();
  });
  loadNetCfgForm();


  const summarySettings235=CxxSummaryUI235.mount({document,root:$('net-status').parentElement,service:newsService,settings:true});
  const refreshSummarySettings235=()=>summarySettings235.refresh();
  appListeners.add(()=>{if(terminalVisible&&state.page==='settings')refreshSummarySettings235();});
  $('font-size').addEventListener('input', e => { prefs.font = Number(e.target.value); applyPrefs(); save(); });
  $('texture').addEventListener('input', e => { prefs.texture = Number(e.target.value); applyPrefs(); save(); });
  $('restore-view').addEventListener('change', e => { prefs.restore = e.target.checked; save(); });
  $('reset-settings').addEventListener('click', () => { Object.assign(prefs, defaults); applyPrefs(); save(); announce('显示设置已恢复默认值'); });
  reducedQuery.addEventListener('change', applyPrefs);
  parent.addEventListener('cxx-ui-preferences-changed',applyPrefs);
  window.addEventListener('pagehide',()=>parent.removeEventListener('cxx-ui-preferences-changed',applyPrefs),{once:true});
  document.addEventListener('visibilitychange',()=>{if(document.hidden){stopNetwork();stopPageMotion();}});
  let contentStamp = '';
  function checkContent(event={}) {
    hasInstalledSnapshot=false;const sd=readStatData()||{},revision=contentClient.readHost()?.contentRevision||'';
    const storyArt=Object.entries(sd.terminal?.quests||{}).filter(([,record])=>record.line?.illustrations||record.graph).map(([id,record])=>[id,record.line?.illustrations,record.line?null:record.graph?.nodes,record.line?null:record.graph?.unlocked]);
    const signatures={characters:JSON.stringify([sd.terminal?.gameplay,sd.terminal?.wallet,sd.terminal?.ensemble,window.parent.SillyTavern?.getContext?.().chatMetadata?.__cxx_story_profile]),operations:JSON.stringify([sd.terminal?.quests,sd.terminal?.questJournal,sd.terminal?.wallet,sd.terminal?.ensemble?.control,window.CxxQuests?.actor?.(sd)?.wallet]),media:revision+JSON.stringify([sd.terminal?.gameplay?.events||{},storyArt]),network:revision+JSON.stringify(sd.terminal?.net||{})};
    if(event.topic==='news')signatures.network+=':'+String(event.revision||++netDynamicVersion);
    if(revision!==contentStamp){contentStamp=revision;refreshContent();locationCache=null;}
    for(const [id,entry]of moduleViews){if(entry.signature===signatures[id])continue;entry.signature=signatures[id];entry.dirty=true;if(terminalVisible&&state.page===id){entry.dirty=false;entry.update?.();}}
    Object.assign(lastSignatures,signatures);emitApp({data:true});
  }
  const settingsForm = document.querySelector('.settings-form');
  if (settingsForm) {
    const info = element('p', 'setting-note', '基础与可选内容默认不安装；在更新面板逐版本选收。');
    const openUpdates = button('内容更新与订阅 ↗', 'quiet', () => {
      if (!contentClient?.request('open')) announce('更新器尚未启动，请检查卡更新脚本是否启用');
    });
    settingsForm.append(info, openUpdates);
    settingsForm.append(button('换卡迁移与存档 ↗','quiet',()=>{
      if(!contentClient?.request('migration'))announce('迁移入口需要新版角色卡；这里只读取内容，不上传存档。');
    }));
  }
  window.addEventListener('pagehide', () => { clearTimeout(viewTimer);saveView();releaseHostViewport(); stopNetwork();  stopPageMotion(); save(); });
  window.addEventListener('pageshow', () => checkContent());

