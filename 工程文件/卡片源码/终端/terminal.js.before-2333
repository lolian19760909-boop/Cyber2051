      const refresh = button('刷新', 'sec-button', () => run(() => inbox.refresh(true), status)); refresh.disabled = s.loading;
      tools.append(status, refresh, button('全部已读', 'sec-button', () => run(() => inbox.mark(), status))); list.append(tools);
