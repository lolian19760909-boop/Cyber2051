  function dimensions(record) {
    const dl = element('dl', 'dimensions');
    (record.dims || []).forEach(d => {
      const group = element('div');
      group.append(element('dt', '', d.k), element('dd', '', d.v));
      if (d.d) group.append(element('p', '', d.d));
      dl.append(group);
    });
    return dl;
  }
