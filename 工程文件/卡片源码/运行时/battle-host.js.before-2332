  async function finishOnce(){if(disposed||!pending?.received||stopped)return false;const p=pending,receipt=p.received,epoch=generation;if(p.scope!==scope())return false;if(top.CxxSource)await top.CxxSource.prime();if(disposed||stopped||pending!==p||p.scope!==scope()||epoch!==generation)return false;const start=Date.now();while(!idle()){if(disposed||pending!==p||p.scope!==scope())return false;if(Date.now()-start>30000)throw Error('本轮正文已完成，变量处理仍未结束；结果已保留，可稍后重试保存。');await new Promise(r=>setTimeout(r,150));}
