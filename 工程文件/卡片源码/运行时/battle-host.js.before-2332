  function idle(){return !ctx().isGenerating&&!api.builtin?.duringGenerating?.()&&!api.Mvu?.isDuringExtraAnalysis?.()&&!top.Mvu?.isDuringExtraAnalysis?.()&&!top.__cxx_gal_g1__?.numericBusy?.();}
  function schedule(){if(timer||disposed)return;timer=setTimeout(()=>{timer=null;const owner=scope(),epoch=generation;void finish().then(()=>{if(disposed||closing)return;if(!idle()){if(!closureWait)closureWait=Date.now();if(Date.now()-closureWait<30000)schedule();return;}closureWait=0;return checkClosure();}).catch(e=>{if(!disposed&&owner===scope()&&epoch===generation)warn(e);});},150);}
