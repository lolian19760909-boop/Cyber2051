  function start(){top.__cxx_battle__?.destroy();top.__cxx_battle__=service;load();schedule();on('CHAT_CHANGED',()=>{load();schedule();});on('GENERATION_STARTED',(_,options,dryRun)=>{if(!dryRun)stopped=false;});on('GENERATION_STOPPED',stoppedGeneration);on('MESSAGE_RECEIVED',received);on('MESSAGE_SENT',floor=>{if(running&&pending&&pending.scope===scope()){pending.sourceBranch=branch(Number.isInteger(floor)?floor:ctx().chat.length-1);persist();}});on('GENERATION_ENDED',schedule);on('MESSAGE_SWIPED',()=>{if(!ctx().isGenerating){cancelPreparation();cancelRecognition();cancelClosure();roster=null;running=null;generation++;schedule();}});
   const changed=()=>{if(reportingError)return;closureWait=0;schedule();};top.addEventListener?.('cxx-player-changed',changed);listeners.push(()=>top.removeEventListener?.('cxx-player-changed',changed));return service;}
  const service={preflight,prepare,pendingFor,finish,recognize,encounter,authorizeEncounter,cancelRecognition,cancelPreparation,assertOperation,authorizeRoster,confirmRoster,authorizeClosure,endBattle,checkClosure,roster:()=>roster?copy(roster):null,state:()=>({pending:!!pending,received:!!pending?.received,error,stage,recognizing:!!turnId||!!scanId,closing:!!closureId}),start,destroy(){disposed=true;cancelRecognition();cancelPreparation();cancelClosure();scene=null;clearTimeout(timer);listeners.splice(0).forEach(f=>f());if(top.__cxx_battle__===service)delete top.__cxx_battle__;}};return service;
 }
 return {create};
});
