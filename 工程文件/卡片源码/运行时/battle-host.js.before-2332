  function currentStat(){for(const m of ctx().chat.slice().reverse()){const s=m.variables?.[m.swipe_id||0]?.stat_data;if(s?.terminal)return s;}const live=liveStat();if(live)return live;throw Error('当前分支的人物存档尚未就绪。');}
