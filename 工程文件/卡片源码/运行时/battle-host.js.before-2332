 function create({api=root,top=root.parent||root,B=root.CxxBattle}){const C=root.CxxBattleContext||(typeof module==='object'&&module.exports?require('./battle-context.js'):null),ctx=()=>api.SillyTavern.getContext(),listeners=[],copy=v=>structuredClone(v);let pending=null,running=null,stopped=false,error='',disposed=false,generation=0,timer=null,finishFlight=null,scene=null,scanEpoch=0,scanId=null,ready=null,turnId=null,turnEpoch=0,roster=null,closureProof=null,closureId=null,closureEpoch=0,stage='idle',closing=false,closureWait=0,reportingError=false,warningKey='';
