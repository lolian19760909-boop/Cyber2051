(function(root,factory){const api=factory(root);if(typeof module==='object'&&module.exports)module.exports=api;else root.CxxBattleSurface=api;})(globalThis,function(root){
 'use strict';
 const css=root.CxxBattleSurfaceStyle||'';
 function create({api,top=api.parent||api}){
  const doc=top.document,off=[];let button,strip,dismiss,manual,style,dialog,view,observer,timer,stopped=false,generationStopped=false,location='',chatScope='',pendingSignal=null,notice=null,hiddenBattle='',resolving=false,detailError='',failedResolve=null;
  const seen=new Map(),branches=new WeakMap();let branchRevision=0;
  const A=root.CxxEnsembleState||top.CxxEnsembleState;
  function branchKey(chat){return chat.map(row=>{let saved=branches.get(row);if(!saved||saved.text!==row.mes||saved.swipe!==(row.swipe_id||0)){saved={text:row.mes,swipe:row.swipe_id||0,id:++branchRevision};branches.set(row,saved);}return saved.id;});}
  const context=()=>top.SillyTavern?.getContext?.()||api.SillyTavern?.getContext?.()||{};
  function liveStat(){const s=top.Cxx236State||root.Cxx236State;if(!s||typeof s.stat!=='function')return null;try{const v=s.stat();return v&&v.terminal?v:null;}catch(e){return null;}}
  function current(){const c=context(),chat=c.chat||[];let game=null,actorId='player',binding=null;for(let i=chat.length-1;i>=0;i--){const m=chat[i],v=Array.isArray(m.variables)?m.variables[m.swipe_id||0]:m.variables;if(v?.stat_data?.terminal?.gameplay){const actor=A?.selected(v.stat_data);game=actor?.gameplay||v.stat_data.terminal.gameplay;actorId=actor?.actorId||'player';binding=actor?.binding||null;break;}}if(!game){const stat=liveStat();if(stat?.terminal?.gameplay){const actor=A?.selected(stat);game=actor?.gameplay||stat.terminal.gameplay;actorId=actor?.actorId||'player';binding=actor?.binding||null;}}const identity=[c.characters?.[c.characterId]?.avatar,c.getCurrentChatId?.()];return {game,chatScope:JSON.stringify(identity),scope:JSON.stringify([...identity,actorId,binding,branchKey(chat)])};}
  function remember(){try{top.sessionStorage?.setItem('cxx-battle-notice:'+chatScope,JSON.stringify({notice,hiddenBattle}));}catch{}}
  function close(){view?.destroy();view=null;if(dialog){if(dialog.open)dialog.close();dialog.remove();dialog=null;}button?.setAttribute('aria-expanded','false');}
  function refresh(){if(stopped)return;const state=current(),{game,scope}=state;if(location&&location!==scope)close();location=scope;if(failedResolve&&(failedResolve.scope!==scope||failedResolve.id!==game?.tactical?.encounter?.id)){failedResolve=null;detailError='';}if(chatScope!==state.chatScope){chatScope=state.chatScope;pendingSignal=null;generationStopped=false;seen.clear();notice=null;hiddenBattle='';detailError='';failedResolve=null;try{const saved=JSON.parse(top.sessionStorage?.getItem('cxx-battle-notice:'+chatScope)||'null');notice=saved?.notice||null;hiddenBattle=saved?.hiddenBattle||'';}catch{}}
   if(notice){const row=context().chat?.[notice.floor];if(!row||(row.swipe_id||0)!==notice.swipe||row.mes!==notice.text){notice=null;remember();}}
   const gal=doc.querySelector('#cxx-galgame-root'),visible=gal&&!gal.hidden,header=gal?.querySelector('.cxx-gal-header');if(header&&strip.previousElementSibling!==header)header.after(strip);else if(!visible&&strip.parentNode!==doc.body)doc.body.append(strip);
   const legacy=game?.numeric?.combat,c=legacy?.active?legacy:game?.tactical?.encounter,active=c?.active;const mode=battleMode(),report=reportOf(state);if(active&&mode!=='tactical'&&!legacy?.active)autoResolve(state); if(!game?.tactical?.enabled&&!legacy?.active)notice=null;strip.hidden=!visible||!game?.growth||gal?.dataset.opening==='1'||(!failedResolve&&(active?hiddenBattle===c.id:report?hiddenBattle===c?.id:!notice||notice.dismissed||notice.closedId!==(c?.closed?c.id:'')));
   const menu=visible&&gal.querySelector('#cxx-gal-more-items');if(menu&&manual.parentNode!==menu)menu.append(manual);else if(!menu)manual.remove();manual.hidden=!menu||!game?.growth||gal?.dataset.opening==='1';
   const label=detailError?'结算未完成 · 点击处理':active?(legacy?.active?(c.paused?'战斗已暂停':'第 '+((c.round||0)+1)+' 轮'):(mode==='tactical'?(c.paused?'战斗已暂停':'第 '+((c.round||0))+' 轮'):(report?'已速决 · '+(report.outcome==='victory'?'占优':report.outcome==='defeat'?'失手':'僵持'):'结算中…'))):(report?'查看战报':'战况待确认'),detail=detailError|| (active?(legacy?.active?'输入行动后发送 · 可查看或修正':mode==='tactical'?'打开面板连续操作 · 关键节点续写':'点开看逐条战报 · 设置里可改回逐轮'):'查看并识别；确认前不开始战斗');if(button.firstChild.textContent!==label)button.firstChild.textContent=label;if(button.lastChild.textContent!==detail)button.lastChild.textContent=detail;
  }
  function battleMode(){try{const v=api.getVariables({type:'chat'})?.['__cxx_ui_preferences'];return ['tactical','fast','text'].includes(v?.battleMode)?v.battleMode:'fast';}catch{return 'fast';}}
  function reportOf(state=current()){const t=state.game?.tactical,c=t?.encounter,legacy=state.game?.numeric?.combat;if(legacy?.active||!c)return null;const r=t.lastReport;if(r?.encounterId===c.id)return r;const old=c.lastReport;return old&&(!old.encounterId||old.encounterId===c.id)?old:null;}
  const settled=new Set();
  const resolveKey=state=>JSON.stringify([state.scope,state.game?.tactical?.encounter?.id,state.game?.tactical?.revision||0,state.game?.tactical?.encounter?.revision||0]);
  function rememberSettled(key){settled.add(key);if(settled.size>128)settled.delete(settled.values().next().value);}
  function sameResolve(state,owner,id){return state.scope===owner&&state.game?.tactical?.encounter?.id===id;}
  function autoResolve(state){const mode=battleMode(),c=state.game?.tactical?.encounter;if(mode==='tactical'||!state.game?.tactical?.enabled||!c?.active||c.paused||resolving||failedResolve)return;
   const key=resolveKey(state);if(settled.has(key))return;
   const tactical=top.__cxx_tactical__;if(!tactical?.operation||context().isGenerating||api.builtin?.duringGenerating?.()||api.Mvu?.isDuringExtraAnalysis?.()||top.Mvu?.isDuringExtraAnalysis?.()||tactical.busy?.())return;
   const report=reportOf(state);if(report&&report.outcome!=='stalemate')return;
   const owner=state.scope,id=c.id;resolving=true;detailError='';
   Promise.resolve().then(()=>{if(!sameResolve(current(),owner,id))return false;return tactical.operation('tactical-resolve',{maxRounds:mode==='text'?12:10,strategy:top.Cxx236Preferences?.read?.().fastStrategy||'auto'});}).then(()=>{
    const now=current();if(!sameResolve(now,owner,id))return;rememberSettled(key);rememberSettled(resolveKey(now));
   }).catch(e=>{const now=current();if(!sameResolve(now,owner,id))return;detailError=e?.message||String(e);failedResolve={scope:owner,id,key,saveOnly:resolveKey(now)!==key};}).finally(()=>{resolving=false;refreshing(true);});}
  async function retryResolve(){const failed=failedResolve,state=current();if(!failed||resolving||!sameResolve(state,failed.scope,failed.id))return false;const tactical=top.__cxx_tactical__;
   if(!failed.saveOnly){failedResolve=null;detailError='';autoResolve(state);return true;}
   resolving=true;try{if(!tactical?.retrySave)throw Error('保存服务尚未就绪，请稍后重试。');await tactical.retrySave();const now=current();if(!sameResolve(now,failed.scope,failed.id))return false;rememberSettled(failed.key);rememberSettled(resolveKey(now));failedResolve=null;detailError='';return true;}
   catch(e){if(sameResolve(current(),failed.scope,failed.id))detailError=e?.message||String(e);return false;}finally{resolving=false;refreshing(true);}}
  function refreshing(report=false){try{refresh();if(report&&dialog?.open&&dialog.dataset.report==='true')showReport();}catch{}}
  function outcomeText(r){if(!r)return '';const who=r.outcome==='victory'?'撑住了这一轮':r.outcome==='defeat'?'被压了下去':'僵持未决';const enemy=(r.enemies||[]).map(e=>e.name+' '+(e.before??'?')+' → '+(e.down?'失能':e.after)).join('，');return who+'：玩家生命 '+r.player.before+' → '+r.player.after+'（'+(r.player.delta>=0?'+':'')+r.player.delta+'）'+(enemy?'；'+enemy:'')+'；'+r.rounds+' 轮 '+r.actions+' 次行动。';}
  function showReport(){const state=current(),r=reportOf(state),mode=battleMode();if(dialog?.open)close();dialog=doc.createElement('dialog');dialog.className='cxx-battle-dialog';dialog.setAttribute('aria-label','战报');dialog.dataset.report='true';
   const header=doc.createElement('header'),title=doc.createElement('div'),eyebrow=doc.createElement('small'),heading=doc.createElement('h2'),exit=doc.createElement('button'),body=doc.createElement('div');
   eyebrow.textContent='TOKYO 2051 / AFTER ACTION';heading.textContent=mode==='text'?'战斗已并入正文':'战报';title.append(eyebrow,heading);
   exit.textContent='收起 ×';exit.type='button';exit.onclick=close;header.append(title,exit);body.className='battle-surface-body';dialog.append(header,body);doc.body.append(dialog);
   dialog.addEventListener('cancel',e=>{e.preventDefault();close();});
   if(detailError){const failure=doc.createElement('p'),retry=doc.createElement('button');failure.setAttribute('role','status');failure.textContent=detailError;retry.type='button';retry.textContent=failedResolve?.saveOnly?'重试保存':'重试结算';retry.disabled=resolving;retry.onclick=()=>{retry.disabled=true;void retryResolve();};body.append(failure,retry);}
   const sum=doc.createElement('p');sum.className='cxx-battle-report-sum';sum.textContent=r?outcomeText(r):'这一战还没有结算记录。';body.append(sum);
   if(r){const list=doc.createElement('ol');list.className='cxx-battle-report-lines';for(const line of r.lines||[]){const li=doc.createElement('li');li.textContent=line;list.append(li);}body.append(list);}
   const foot=doc.createElement('p');foot.className='identity-note';foot.textContent='速决与即时战术共用结算。按已保存策略使用现有武器、动作、义体和破解程序，消耗真实弹药、耐力与 RAM；手雷、部署、主动治疗剂和超频仍需手动选择。天赋百分比为同组相加的加成项。可在设置中切换策略或即时战术。';body.append(foot);
   doc.body.append(dialog);dialog.showModal();button.setAttribute('aria-expanded','true');exit.focus({preventScroll:true});return true;}

  function open(options={}){refresh();const opened=current();if(opened.game?.growth&&battleMode()!=='tactical'&&!opened.game?.numeric?.combat?.active)(opened.game?.tactical?.encounter?.active||reportOf(opened)||failedResolve)&&showReport();if(battleMode()!=='tactical'&&!current().game?.numeric?.combat?.active)return true;if(!current().game?.growth){top.toastr?.info('请先完成开局建档。','战斗');return false;}const player=top.__cxx_player__;if(!player)return false;if(dialog?.open){dialog.focus();return true;}top.Cxx233Terminal?.close();top.CxxAtlasTool?.close();dialog=doc.createElement('dialog');dialog.className='cxx-battle-dialog';dialog.setAttribute('aria-label','逐轮战斗面板');const header=doc.createElement('header'),title=doc.createElement('div'),eyebrow=doc.createElement('small'),heading=doc.createElement('h2'),exit=doc.createElement('button'),body=doc.createElement('div');eyebrow.textContent='TOKYO 2051 / TACTICAL LINK';heading.textContent=options.automatic?'战况待确认':'交锋控制';title.append(eyebrow,heading);exit.textContent='返回 ×';exit.type='button';exit.onclick=close;header.append(title,exit);body.className='battle-surface-body';dialog.append(header,body);doc.body.append(dialog);dialog.addEventListener('cancel',e=>{e.preventDefault();close();});dialog.showModal();button.setAttribute('aria-expanded','true');view=player.mount(body,'战斗',{navigation:false,appearanceStyle:'.app>.eyebrow,.app>.title{display:none}.app{padding:12px!important;background:transparent!important}.app>.layout{margin:0}.status:empty{display:none}'});exit.focus({preventScroll:true});return true;}
  // Only a completed, validated scene protocol may request a prompt. This
  // never parses combat words, calls the extra API or writes a combat state.
  function received(floor){refresh();if(!current().game?.tactical?.enabled)return;const c=context(),chat=c.chat||[],row=chat[floor],stream=c.streamingProcessor;if(generationStopped||floor!==chat.length-1||!row||row.is_user||row.is_system||stream?.messageId===floor&&stream?.abortController?.signal.aborted)return;const parser=api.CxxGalParser||top.CxxGalParser;if(!parser?.parseMessage(row.mes||'').scene?.combatPending)return;const key=floor+':'+(row.swipe_id||0);if(seen.get(key)===row)return;pendingSignal={key,row,scope:chatScope,floor,swipe:row.swipe_id||0,text:row.mes};tryPending();}
  function tryPending(){if(!pendingSignal||stopped||generationStopped)return;const state=current(),p=pendingSignal,row=context().chat?.[p.floor];if(state.chatScope!==p.scope||row!==p.row||(row?.swipe_id||0)!==p.swipe||row?.mes!==p.text||state.game?.numeric?.combat?.active){pendingSignal=null;return;}if(context().isGenerating||api.builtin?.duringGenerating?.()||!state.game?.growth)return;
   const parser=api.CxxGalParser||top.CxxGalParser,place=parser?.parseMessage(p.text).scene?.location||'',c=state.game?.numeric?.combat,closedId=c?.closed?c.id:'';
   if(!notice||notice.place!==place||notice.closedId!==closedId)notice={floor:p.floor,swipe:p.swipe,text:p.text,place,closedId,dismissed:false};
   seen.set(p.key,p.row);if(seen.size>128)seen.delete(seen.keys().next().value);pendingSignal=null;remember();refresh();
  }
  function on(name,fn){if(!name)return;api.eventOn?.(name,fn);off.push(()=>api.eventRemoveListener?.(name,fn));}
  function start(){top.__cxx_battle_surface__?.destroy();top.__cxx_battle_surface__=service;style=doc.createElement('style');style.textContent=css;doc.head.append(style);strip=doc.createElement('aside');strip.className='cxx-battle-strip';button=doc.createElement('button');button.type='button';button.className='cxx-battle-launch';button.setAttribute('aria-haspopup','dialog');button.setAttribute('aria-expanded','false');button.append(doc.createElement('span'),doc.createElement('small'));button.onclick=()=>open();dismiss=doc.createElement('button');dismiss.type='button';dismiss.className='cxx-battle-dismiss';dismiss.textContent='×';dismiss.setAttribute('aria-label','收起战斗提示，可从更多菜单重新打开');dismiss.onclick=()=>{const game=current().game,c=game?.numeric?.combat?.active?game.numeric.combat:game?.tactical?.encounter;if(c?.id)hiddenBattle=c.id;else if(notice)notice.dismissed=true;remember();refresh();};strip.append(button,dismiss);doc.body.append(strip);manual=doc.createElement('button');manual.type='button';manual.className='cxx-gal-button cxx-battle-manual';manual.textContent='战斗';manual.onclick=()=>{manual.closest('details')?.removeAttribute('open');open();};const changed=()=>{refresh();tryPending();};top.addEventListener('cxx-player-changed',changed);off.push(()=>top.removeEventListener('cxx-player-changed',changed));const events=api.tavern_events||context().eventTypes||{};for(const name of ['CHAT_CHANGED','MESSAGE_SWIPED','MESSAGE_DELETED'])on(events[name],refresh);on(events.MESSAGE_RECEIVED,received);on(events.GENERATION_STARTED,(type,options,dryRun)=>{if(!dryRun&&['normal','continue','swipe','regenerate'].includes(type))generationStopped=false;});on(events.GENERATION_STOPPED,()=>{generationStopped=true;pendingSignal=null;});on(events.GENERATION_ENDED,()=>{refresh();tryPending();});if(api.getButtonEvent)on(api.getButtonEvent('战斗'),()=>open());observer=new top.MutationObserver(()=>{clearTimeout(timer);timer=setTimeout(refresh,40);});observer.observe(doc.body,{childList:true});doc.addEventListener('toggle',refresh,true);off.push(()=>doc.removeEventListener('toggle',refresh,true));refresh();return service;}
  function destroy(){stopped=true;clearTimeout(timer);observer?.disconnect();off.splice(0).forEach(fn=>fn());close();strip?.remove();manual?.remove();style?.remove();pendingSignal=null;seen.clear();if(top.__cxx_battle_surface__===service)delete top.__cxx_battle_surface__;}
  const service={start,open,close,refresh,retryResolve,destroy};return service;
 }
 return {create};
});
