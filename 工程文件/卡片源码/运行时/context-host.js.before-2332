    function start(){bind();const c=ctx();for(const name of ['CHAT_CHANGED'])if(c.eventTypes?.[name]){const fn=()=>{try{bind();}catch(e){lastError=e.message;top.toastr?.error(e.message);}};c.eventSource.on(c.eventTypes[name],fn);listeners.push(()=>c.eventSource.removeListener(c.eventTypes[name],fn));}const tokenEvent=c.eventTypes?.STREAM_TOKEN_RECEIVED;if(tokenEvent){c.eventSource.on(tokenEvent,streaming);listeners.push(()=>c.eventSource.removeListener(tokenEvent,streaming));}const rendered=c.eventTypes?.CHARACTER_MESSAGE_RENDERED;if(rendered){const done=floor=>{if(rendering?.floor===floor&&ctx().chat[floor]===rendering.row)releaseRendering();};c.eventSource.on(rendered,done);listeners.push(()=>c.eventSource.removeListener(rendered,done));}return service;}
    function destroy(){stopped=true;releaseRendering();detach?.();detach=null;attached=null;round=null;listeners.splice(0).forEach(fn=>fn());}
    const service={start,destroy,capture:persist,retry:()=>persist(),refreshIndex,reference,validSource,validSources,token,generationBinding,use(value){if(round&&!round.paused)fail('context-busy','生成中不能更换上下文策略。');policy=value;return service;},binding:()=>copy(currentBinding()),preview:()=>S.plan(ctx().chat,{resolveBinding:legacyBinding}),index:()=>copy(lastIndex),status:()=>({connected:!!detach,bridge:attached?.status?.(),pending:!!pending,error:lastError,details:copy(lastMismatch)}),location};return service;
  }
  return {create,metadata,apply};
});
